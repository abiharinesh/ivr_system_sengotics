# Flutter env (loaded via flutter_dotenv from this folder).
# Prefer editing the repo ROOT .env and syncing:
#   node ivr_frontend/scripts/sync_env_from_root.js
#
# Or copy this file to .env and set values manually.

# API origin for Dio (--dart-define=API_BASE_URL=... overrides this)
API_BASE_URL=http://localhost:3000
# Production:
# API_BASE_URL=https://ivr-system-sengotics.vercel.app

# Frontend website origin used for copy/share tender links.
# Example:
# WEB_APP_BASE_URL=https://ivr-system-sengotics.vercel.app
WEB_APP_BASE_URL=http://localhost:8080

# Google Maps JavaScript API (required for Flutter WEB — GIS, pole picker)
# Enable "Maps JavaScript API". HTTP referrer restrictions:
#   http://localhost:8080/*
#   http://127.0.0.1:8080/*
#   https://YOUR_PRODUCTION_DOMAIN/*
GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key_here
