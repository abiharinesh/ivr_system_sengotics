# Google Maps — required for Flutter WEB (dashboard GIS, pole picker). Mobile uses the native SDK.
# Create a key in Google Cloud Console → APIs & Services → Credentials.
# Enable "Maps JavaScript API" for this key.
# Under "Application restrictions" → HTTP referrers, add:
#   http://localhost:8080/*
#   http://127.0.0.1:8080/*
#   https://YOUR_PRODUCTION_DOMAIN/*
GOOGLE_MAPS_API_KEY=AIzaSyBSTuwojMwWo_y7yCXw2C_byoFVqa5z6Ok

# API origin for Dio (all platforms). Highest priority after --dart-define=API_BASE_URL=...
# Local backend (NestJS default): use this when running `npm run start:dev` on port 3000.
API_BASE_URL=http://localhost:3000

# Production / hosted Flutter pointing at deployed API:
# API_BASE_URL=https://ivr-system-sengotics.vercel.app
