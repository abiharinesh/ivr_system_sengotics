    {
      "name": "Flutter Web (Chrome, live API)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome", "--dart-define=API_BASE_URL=https://ivr-system-sengotics.vercel.app"]
    }
  ]
}
