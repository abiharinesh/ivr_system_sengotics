# =============================================================================
# IVR System — environment template (copy to .env and fill in values)
#   cp .env.example .env
# Never commit real secrets. On Vercel, set the same keys in Project → Settings → Environment Variables.
# =============================================================================

# --- Core server ---
NODE_ENV=development
PORT=3000

# --- Database (Prisma) ---
# Local Docker: postgresql://postgres:postgres@localhost:5432/ivr_system?schema=public
# Supabase pooler (recommended for serverless):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Optional: max connections per Prisma pool (default 3; keep low on Vercel)
DB_POOL_MAX=3

# --- Docker Compose only (postgres service; ignored by Nest if DATABASE_URL is set) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ivr_system

# --- Auth (required) ---
JWT_SECRET=change_me_to_a_long_random_string

# --- AI / voice processing ---
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_SPEECH_API_KEY=
GOOGLE_VISION_API_KEY=
# Optional: RapidAPI Tamil transcription fallback
RAPIDAPI_KEY=

# --- Exotel (call recording fetch) ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# --- Google Maps (Flutter web + sync to ivr_frontend/.env) ---
GOOGLE_MAPS_API_KEY=

# --- Flutter client (synced to ivr_frontend/.env via scripts/sync_env_from_root.js) ---
FLUTTER_API_BASE_URL=http://localhost:3000

# --- Tender PDF generation (production on Vercel) ---
# Gotenberg: host your own instance (Fly.io, Railway, etc.) — HTML → PDF
GOTENBERG_URL=
GOTENBERG_TIMEOUT_MS=45000

# --- Tender document storage (Supabase Storage; required on Vercel) ---
# Project URL: https://PROJECT_REF.supabase.co (same project as DATABASE_URL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tender-documents

# Comma-separated template ids that cannot use canvas editor (empty = all editable)
# Example to lock only Form 19: CANVAS_LOCKED_TEMPLATES=form19
# Example multiple: CANVAS_LOCKED_TEMPLATES=work_order,so_proceedings
CANVAS_LOCKED_TEMPLATES=

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Field verification (geotag overlay OCR) ---
# Tesseract.js on server; no Google key required when enabled
FIELD_OCR_ENABLED=true
# Match radius in meters (default 120)
FIELD_MATCH_RADIUS_M=120

# --- Legacy / unused by Nest (optional scripts only) ---
OPENAI_API_KEY=
