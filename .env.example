# Docker Environment Variables
# Copy this file to .env and update with your values

# Database Configuration (for Docker PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ivr_system

# Application Port
PORT=3000

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Supabase (Optional - only if using Supabase instead of Docker PostgreSQL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Database URL (for Prisma - automatically set by docker-compose)
# DATABASE_URL will be set automatically in docker-compose.yml
