  penalty_amount  Decimal   @default(0) @db.Decimal(12, 2)
  paid_amount     Decimal   @default(0) @db.Decimal(12, 2)
  payment_method  String? // upi, razorpay, cash, bank_transfer
  transaction_ref String?
  paid_at         DateTime?
  receipt_url     String?
  status          String    @default("unpaid") // unpaid, partial, paid, overdue
  due_date        DateTime
  created_at      DateTime  @default(now())

  property TaxProperty @relation(fields: [property_id], references: [id])

  @@index([property_id, financial_year])
