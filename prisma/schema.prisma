generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model CallsMaster {
  call_sid          String    @id
  caller_number     String?
  call_to           String?
  flow_id           String?
  tenant_id         String?
  call_start_time   DateTime?
  call_end_time     DateTime?
  service_selected  Boolean   @default(false)
  poll_entered      Boolean   @default(false)
  final_call_status String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  service_selections IvrServiceSelection[]
  poll_inputs        IvrPollInput[]

  @@map("calls_master")
}

model IvrServiceSelection {
  id             BigInt      @id @default(autoincrement())
  call_sid       String
  caller_number  String?
  service_option String?
  received_at    DateTime    @default(now())
  raw_payload    Json?

  call           CallsMaster @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_service_selection")
}

model IvrPollInput {
  id            BigInt      @id @default(autoincrement())
  call_sid      String
  caller_number String?
  poll_id       String?
  received_at   DateTime    @default(now())
  raw_payload   Json?

  call          CallsMaster @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_poll_input")
}


model VoiceCall {
  id                   Int       @id @default(autoincrement())
  call_sid             String?
  audio_url            String?
  transcript           String?
  transcript_english   String?
  ai_extracted_json    Json?
  processing_status    String    @default("pending")
  confidence_score     Float?
  attempt_number       Int       @default(1)
  created_at           DateTime  @default(now())

  complaints        Complaint[]

  @@unique([call_sid, audio_url])
  @@index([call_sid, attempt_number])
  @@map("voice_calls")
}

model Panchayat {
  id             Int                     @id @default(autoincrement())
  name           String
  boundary       Unsupported("geometry(Polygon, 4326)")?
  center_lat     Float?
  center_lng     Float?
  ivr_number     String?                 @unique

  electric_poles ElectricPole[]
  complaints     Complaint[]
  users          User[]
  export_jobs    ExportJob[]
  tenders        Tender[]
  work_orders    WorkOrder[]

  @@map("panchayats")
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password_hash String
  role          String     @default("panchayat_admin")
  panchayat_id  Int?
  phone_e164    String?
  created_at    DateTime   @default(now())

  panchayat            Panchayat?    @relation(fields: [panchayat_id], references: [id])
  assigned_complaints  Complaint[]   @relation("AssignedElectrician")
  pole_image_uploads   ElectricPole[] @relation("PoleImageUploader")

  export_jobs_created    ExportJob[] @relation("ExportJobCreator")
  export_jobs_as_subject ExportJob[] @relation("ExportJobElectrician")
  created_tenders        Tender[]    @relation("TenderCreator")
  awarded_work_orders    WorkOrder[] @relation("WorkOrderApprover")
  vendor_quotations      Quotation[] @relation("QuotationVendorUser")
  vendor_invite_links    TenderInviteLink[] @relation("InviteVendorUser")

  @@map("users")
}

model ElectricPole {
  id           Int                                  @id @default(autoincrement())
  pole_number  String?
  keypad_id    String?
  location     Unsupported("geometry(Point, 4326)")?
  latitude     Float?
  longitude    Float?
  panchayat_id Int?
  landmarks    String[]                             @default([])

  image_url           String?
  image_latitude      Float?
  image_longitude     Float?
  image_captured_at   DateTime?
  image_uploaded_at   DateTime?
  image_uploaded_by   Int?

  panchayat     Panchayat?   @relation(fields: [panchayat_id], references: [id])
  complaints    Complaint[]
  image_uploader User?       @relation("PoleImageUploader", fields: [image_uploaded_by], references: [id])
  work_order_items WorkOrderItem[]
  work_proofs      WorkProof[]

  @@unique([panchayat_id, keypad_id])
  @@map("electric_poles")
}

model Complaint {
  id              Int      @id @default(autoincrement())
  voice_call_id   Int?
  pole_id         Int?
  panchayat_id    Int?
  complaint_type  String?
  description     String?
  caller_language String?
  caller_emotion  String?
  urgency_level   String?
  audio_url       String?
  status          String   @default("pending")
  created_at      DateTime @default(now())

  category                String?
  whatsapp_done_ack_at    DateTime?

  assigned_electrician_id Int?
  assigned_at             DateTime?
  resolved_at             DateTime?

  resolution_image_url            String?
  resolution_note                 String?
  resolution_image_latitude       Float?
  resolution_image_longitude      Float?
  resolution_image_captured_at    DateTime?
  resolution_distance_meters      Float?
  resolution_location_valid       Boolean?
  resolution_submitted_key        String? @unique

  voice_call          VoiceCall?    @relation(fields: [voice_call_id], references: [id])
  pole                ElectricPole? @relation(fields: [pole_id], references: [id])
  panchayat           Panchayat?    @relation(fields: [panchayat_id], references: [id])
  assigned_electrician User?       @relation("AssignedElectrician", fields: [assigned_electrician_id], references: [id])
  tender_links         TenderComplaint[]
  work_order_items     WorkOrderItem[]
  work_proofs          WorkProof[]
  resolution_audits    ComplaintResolutionAudit[]

  @@map("complaints")
}

model CallState {
  id                   Int       @id @default(autoincrement())
  call_sid             String    @unique
  phase1_status        String    @default("pending")
  phase2_status        String    @default("pending")
  complaint_created    Boolean   @default(false)
  complaint_id         Int?
  phase1_voice_call_id Int?
  phase2_voice_call_id Int?
  finalized_at         DateTime?
  last_error           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([call_sid])
  @@map("call_state")
}

model SystemSettings {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

/** Async ZIP export of resolved complaints + proof images (admin). */
model ExportJob {
  id                   Int       @id @default(autoincrement())
  created_by_user_id   Int
  panchayat_id         Int?
  electrician_user_id  Int
  range_from           DateTime
  range_to             DateTime
  status               String    @default("pending")
  result_relative_path String?
  error_message        String?
  row_count            Int?
  created_at           DateTime  @default(now())
  completed_at         DateTime?

  created_by  User      @relation("ExportJobCreator", fields: [created_by_user_id], references: [id])
  electrician User      @relation("ExportJobElectrician", fields: [electrician_user_id], references: [id])
  panchayat   Panchayat? @relation(fields: [panchayat_id], references: [id])

  @@index([electrician_user_id])
  @@index([status])
  @@map("export_jobs")
}

enum TenderStatus {
  draft
  open_for_quotations
  awarded
  cancelled
}

enum QuotationStatus {
  submitted
  shortlisted
  awarded
  rejected
}

enum WorkOrderStatus {
  created
  in_progress
  completed
  cancelled
}

enum WorkProofStatus {
  pending_verification
  matched
  unmatched_manual_review
  rejected
}

enum LinkPurpose {
  tender_submission
  work_upload
}

model Tender {
  id                  Int         @id @default(autoincrement())
  tender_code         String      @unique
  panchayat_id        Int
  complaint_count     Int
  required_quantity   Int
  light_type          String?
  work_type           String
  submission_deadline DateTime
  scoring_config      Json
  status              TenderStatus @default(open_for_quotations)
  created_by_user_id  Int
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  panchayat           Panchayat   @relation(fields: [panchayat_id], references: [id])
  created_by          User        @relation("TenderCreator", fields: [created_by_user_id], references: [id])
  complaint_links     TenderComplaint[]
  invite_links        TenderInviteLink[]
  quotations          Quotation[]
  work_orders         WorkOrder[]

  @@index([panchayat_id, status])
  @@map("tenders")
}

model TenderComplaint {
  id           Int       @id @default(autoincrement())
  tender_id    Int
  complaint_id Int
  created_at   DateTime  @default(now())

  tender       Tender    @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  @@unique([tender_id, complaint_id])
  @@index([complaint_id])
  @@map("tender_complaints")
}

model TenderInviteLink {
  id               Int         @id @default(autoincrement())
  tender_id        Int
  purpose          LinkPurpose
  token_hash       String      @unique
  token_hint       String?
  expires_at       DateTime
  max_submissions  Int?
  used_count       Int         @default(0)
  is_revoked       Boolean     @default(false)
  vendor_user_id   Int?
  work_order_id    Int?
  created_at       DateTime    @default(now())

  tender           Tender      @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  vendor_user      User?       @relation("InviteVendorUser", fields: [vendor_user_id], references: [id])
  work_order       WorkOrder?  @relation(fields: [work_order_id], references: [id], onDelete: SetNull)

  @@index([tender_id, purpose, expires_at])
  @@map("tender_invite_links")
}

model Quotation {
  id                    Int             @id @default(autoincrement())
  tender_id             Int
  vendor_user_id        Int?
  company_name          String
  contact_person        String
  mobile_number         String
  quantity              Int
  price_per_light       Float
  installation_cost     Float           @default(0)
  total_cost            Float
  delivery_days         Int
  warranty_months       Int
  seller_rating         Float           @default(3)
  experience_years      Int             @default(1)
  document_url          String?
  notes                 String?
  score_breakdown       Json?
  final_score           Float?
  status                QuotationStatus @default(submitted)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  tender                Tender          @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  vendor_user           User?           @relation("QuotationVendorUser", fields: [vendor_user_id], references: [id])
  work_order            WorkOrder?

  @@index([tender_id, status, final_score])
  @@map("quotations")
}

model WorkOrder {
  id                   Int             @id @default(autoincrement())
  work_order_code      String          @unique
  tender_id            Int
  quotation_id         Int             @unique
  panchayat_id         Int
  approved_by_user_id  Int
  assigned_vendor_name String
  assigned_vendor_phone String
  quantity             Int
  status               WorkOrderStatus @default(created)
  due_date             DateTime?
  completed_at         DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  tender               Tender          @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  quotation            Quotation       @relation(fields: [quotation_id], references: [id], onDelete: Restrict)
  panchayat            Panchayat       @relation(fields: [panchayat_id], references: [id])
  approved_by          User            @relation("WorkOrderApprover", fields: [approved_by_user_id], references: [id])
  items                WorkOrderItem[]
  proof_links          TenderInviteLink[]
  proofs               WorkProof[]

  @@index([panchayat_id, status])
  @@map("work_orders")
}

model WorkOrderItem {
  id             Int        @id @default(autoincrement())
  work_order_id  Int
  complaint_id   Int
  pole_id        Int
  created_at     DateTime   @default(now())

  work_order     WorkOrder  @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  complaint      Complaint  @relation(fields: [complaint_id], references: [id], onDelete: Restrict)
  pole           ElectricPole @relation(fields: [pole_id], references: [id], onDelete: Restrict)

  @@unique([work_order_id, complaint_id])
  @@index([pole_id])
  @@map("work_order_items")
}

model WorkProof {
  id                     Int             @id @default(autoincrement())
  work_order_id          Int
  complaint_id           Int?
  pole_id                Int?
  image_url              String
  before_image_url       String?
  after_image_url        String?
  captured_at            DateTime?
  uploaded_at            DateTime        @default(now())
  latitude               Float?
  longitude              Float?
  exif_latitude          Float?
  exif_longitude         Float?
  distance_meters        Float?
  adaptive_radius_meters Float?
  match_confidence       Float?
  image_hash             String?         @unique
  status                 WorkProofStatus @default(pending_verification)
  submitted_by_name      String?
  submitted_by_phone     String?
  verification_note      String?

  work_order             WorkOrder       @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  complaint              Complaint?      @relation(fields: [complaint_id], references: [id], onDelete: SetNull)
  pole                   ElectricPole?   @relation(fields: [pole_id], references: [id], onDelete: SetNull)
  audit_entries          ComplaintResolutionAudit[]

  @@index([work_order_id, status])
  @@index([complaint_id])
  @@map("work_proofs")
}

model ComplaintResolutionAudit {
  id              Int      @id @default(autoincrement())
  complaint_id    Int
  work_proof_id   Int?
  action          String
  actor_type      String
  actor_id        Int?
  note            String?
  metadata        Json?
  created_at      DateTime @default(now())

  complaint       Complaint  @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  work_proof      WorkProof? @relation(fields: [work_proof_id], references: [id], onDelete: SetNull)

  @@index([complaint_id, created_at])
  @@map("complaint_resolution_audits")
}
