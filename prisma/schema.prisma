generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// =====================================================================
//  ENUMS — Branch types & statuses for all TN local bodies
// =====================================================================

enum BranchType {
  VILLAGE_PANCHAYAT
  PANCHAYAT_UNION
  DISTRICT_PANCHAYAT
  TOWN_PANCHAYAT
  MUNICIPALITY
  MUNICIPAL_CORPORATION
}

enum BranchStatus {
  DRAFT
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  MERGED
  UPGRADED
  CLOSED
}

model CallsMaster {
  call_sid          String    @id
  caller_number     String?
  call_to           String?
  flow_id           String?
  tenant_id         String?
  call_start_time   DateTime?
  call_end_time     DateTime?
  service_selected  Boolean   @default(false)
  poll_entered      Boolean   @default(false)
  final_call_status String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  service_selections IvrServiceSelection[]
  poll_inputs        IvrPollInput[]

  @@map("calls_master")
}

model IvrServiceSelection {
  id             BigInt   @id @default(autoincrement())
  call_sid       String
  caller_number  String?
  service_option String?
  received_at    DateTime @default(now())
  raw_payload    Json?

  call CallsMaster @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_service_selection")
}

model IvrPollInput {
  id            BigInt   @id @default(autoincrement())
  call_sid      String
  caller_number String?
  poll_id       String?
  received_at   DateTime @default(now())
  raw_payload   Json?

  call CallsMaster @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_poll_input")
}

model VoiceCall {
  id                 Int      @id @default(autoincrement())
  call_sid           String?
  audio_url          String?
  transcript         String?
  transcript_english String?
  ai_extracted_json  Json?
  processing_status  String   @default("pending")
  confidence_score   Float?
  attempt_number     Int      @default(1)
  created_at         DateTime @default(now())

  complaints Complaint[]

  @@unique([call_sid, audio_url])
  @@index([call_sid, attempt_number])
  @@map("voice_calls")
}

model OrgUnit {
  id                         Int                                     @id @default(autoincrement())
  name                       String
  boundary                   Unsupported("geometry(Polygon, 4326)")?
  center_lat                 Float?
  center_lng                 Float?
  ivr_number                 String?                                 @unique
  document_template_settings Json?

  // ── Multi-tenant ──
  tenant_id String @default("default")
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // ── Branch classification ──
  branch_type        BranchType   @default(VILLAGE_PANCHAYAT)
  branch_status      BranchStatus @default(ACTIVE)
  branch_code        String?      @unique
  parent_org_unit_id Int?

  // ── Escalation reference (district/state revenue administration — read-only, not a tenant) ──
  escalation_jurisdiction_id Int?
  escalation_jurisdiction    AdminJurisdiction? @relation(fields: [escalation_jurisdiction_id], references: [id])

  // ── Lifecycle ──
  effective_from    DateTime  @default(now())
  effective_until   DateTime?
  merged_into_id    Int?
  upgraded_to_id    Int?
  status_changed_at DateTime?
  status_changed_by Int?
  status_reason     String?

  // ── Geography ──
  district       String?
  taluk          String?
  block          String?
  village        String?
  ward_count     Int?
  survey_numbers String[] @default([])
  gis_boundary   Json?
  area_sq_km     Float?

  // ── Contact & Branding ──
  contact_phone       String?
  contact_email       String?
  address             String?
  logo_url            String?
  secondary_logo_url  String?
  favicon_url         String?
  software_name_ta    String? @default("ஊராட்சி குரல்")
  software_name_en    String? @default("Ooratchi Kural")
  software_tagline_ta String? @default("குடிமக்கள் சேவை மையம்")
  software_tagline_en String? @default("Citizen Service Portal")
  primary_color       String? @default("#1E3A8A")
  secondary_color     String? @default("#0EA5E9")
  welcome_audio_url   String?
  state_code          String? @default("TN")

  // ── Soft delete ──
  is_active  Boolean   @default(true)
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  // ── Self-relation: org unit hierarchy (District → Union → Village) ──
  parent_org_unit OrgUnit?  @relation("OrgUnitHierarchy", fields: [parent_org_unit_id], references: [id])
  child_org_units OrgUnit[] @relation("OrgUnitHierarchy")

  // ── Existing relations ──
  electric_poles  ElectricPole[]
  water_pipelines WaterPipeline[]
  water_tanks     WaterTankBorewell[]
  water_valves    WaterValve[]
  complaints      Complaint[]
  users           User[]
  export_jobs     ExportJob[]
  vendors         Vendor[]
  tenders         Tender[]
  zones           PanchayatZone[]

  // Revenue module relations
  ad_campaigns         AdCampaign[]
  penalty_rules        PenaltyRule[]
  properties           Property[]
  certificate_requests CertificateRequest[]
  panchayat_assets     PanchayatAsset[]
  market_days          MarketDay[]
  market_vendors       MarketVendor[]

  // ── New platform relations ──
  feature_config     BranchFeatureConfig?
  roles              Role[]
  workflow_templates WorkflowTemplate[]
  departments        Department[]
  employees          Employee[]
  lifecycle_events   BranchLifecycleEvent[]
  userRoles          UserRole[]

  @@index([tenant_id])
  @@index([tenant_id, branch_type])
  @@index([parent_org_unit_id])
  @@index([escalation_jurisdiction_id])
  @@map("org_units")
}

/**
 * Lightweight, read-mostly reference hierarchy for TN district/state revenue
 * administration (Collectorate → RDO → Taluk). NOT a tenant — no login, no
 * branding, no feature toggles. Exists only so an OrgUnit's complaints/requests
 * can escalate to the correct real-world government office.
 */
model AdminJurisdiction {
  id            Int      @id @default(autoincrement())
  type          String // COLLECTORATE | RDO | TALUK | FIRKA
  name          String
  district      String?
  parent_id     Int?
  contact_name  String?
  contact_phone String?
  contact_email String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  parent    AdminJurisdiction?  @relation("JurisdictionHierarchy", fields: [parent_id], references: [id])
  children  AdminJurisdiction[] @relation("JurisdictionHierarchy")
  org_units OrgUnit[]

  @@index([district, type])
  @@index([parent_id])
  @@map("admin_jurisdictions")
}

/**
 * Admin-defined zones within a panchayat. Boundary stored as GeoJSON for flexible rendering.
 */
model PanchayatZone {
  id               Int      @id @default(autoincrement())
  org_unit_id      Int
  name             String
  boundary_geojson Json // GeoJSON Polygon/MultiPolygon
  color            String?  @default("#2563EB")
  opacity          Float    @default(0.3)
  places           String[] @default([])
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@index([org_unit_id])
  @@map("panchayat_zones")
}

model User {
  id                  Int      @id @default(autoincrement())
  tenant_id           String   @default("default")
  email               String?
  password_hash       String
  role                String   @default("panchayat_admin")
  primary_org_unit_id Int? // login/home context — the one org unit a user lands on; multi-role scoping lives on UserRole
  phone_e164          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  // ── Identity & Classification ──
  user_type   String  @default("employee") // employee, citizen, contractor, system
  is_active   Boolean @default(true)
  is_verified Boolean @default(false)

  // ── Login tracking ──
  last_login_at     DateTime?
  last_login_ip     String?
  last_login_device String?
  failed_attempts   Int       @default(0)
  locked_until      DateTime?

  // ── Soft delete ──
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by Int?

  // ── Existing relations ──
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id])
  primary_org_unit       OrgUnit?       @relation(fields: [primary_org_unit_id], references: [id])
  assigned_complaints    Complaint[]    @relation("AssignedElectrician")
  assigned_plumbing_jobs Complaint[]    @relation("AssignedPlumber")
  pole_image_uploads     ElectricPole[] @relation("PoleImageUploader")

  export_jobs_created    ExportJob[] @relation("ExportJobCreator")
  export_jobs_as_subject ExportJob[] @relation("ExportJobElectrician")

  tenders_created        Tender[]                   @relation("TenderCreator")
  tender_documents       TenderDocument[]           @relation("TenderDocGenerator")
  field_sessions_created FieldVerificationSession[] @relation("FieldSessionCreator")
  tender_audit_events    TenderAuditLog[]           @relation("TenderAuditActor")

  // Revenue module relations
  penalties UserPenalty[]

  // ── New platform relations ──
  employee        Employee?
  citizen_profile CitizenProfile?
  user_roles      UserRole[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, phone_e164])
  @@index([tenant_id])
  @@map("users")
}

model ElectricPole {
  id          Int                                   @id @default(autoincrement())
  pole_number String?
  keypad_id   String?
  location    Unsupported("geometry(Point, 4326)")?
  latitude    Float?
  longitude   Float?
  org_unit_id Int?
  landmarks   String[]                              @default([])

  /**
   * Permanent UUID token for public QR-code stickers. Never expires.
   */
  public_report_token String? @unique @default(uuid())

  image_url         String?
  image_latitude    Float?
  image_longitude   Float?
  image_captured_at DateTime?
  image_uploaded_at DateTime?
  image_uploaded_by Int?

  org_unit       OrgUnit?    @relation(fields: [org_unit_id], references: [id])
  complaints     Complaint[]
  image_uploader User?       @relation("PoleImageUploader", fields: [image_uploaded_by], references: [id])

  tender_line_items      TenderLineItem[]
  field_uploads_matched  FieldVerificationUpload[]  @relation("FieldUploadMatched")
  field_uploads_manual   FieldVerificationUpload[]  @relation("FieldUploadManual")
  tender_checklist_items TenderFieldChecklistItem[]

  @@unique([org_unit_id, keypad_id])
  @@map("electric_poles")
}

model Complaint {
  id              Int      @id @default(autoincrement())
  voice_call_id   Int?
  pole_id         Int?
  pipeline_id     Int?
  tank_id         Int?
  org_unit_id     Int?
  complaint_type  String?
  description     String?
  caller_language String?
  caller_emotion  String?
  urgency_level   String?
  audio_url       String?
  status          String   @default("pending")
  created_at      DateTime @default(now())

  category             String?
  whatsapp_done_ack_at DateTime?

  /**
   * Phone number for guest (non-registered) complaints.
   */
  guest_phone          String?
  /**
   * UUID token for anonymous complaint tracking (public URL).
   */
  guest_tracking_token String? @unique

  assigned_electrician_id Int?
  assigned_plumber_id     Int?
  assigned_at             DateTime?
  resolved_at             DateTime?

  resolution_image_url         String?
  resolution_note              String?
  resolution_image_latitude    Float?
  resolution_image_longitude   Float?
  resolution_image_captured_at DateTime?
  resolution_distance_meters   Float?
  resolution_location_valid    Boolean?
  resolution_submitted_key     String?   @unique

  voice_call           VoiceCall?         @relation(fields: [voice_call_id], references: [id])
  pole                 ElectricPole?      @relation(fields: [pole_id], references: [id])
  pipeline             WaterPipeline?     @relation(fields: [pipeline_id], references: [id])
  tank                 WaterTankBorewell? @relation(fields: [tank_id], references: [id])
  org_unit             OrgUnit?           @relation(fields: [org_unit_id], references: [id])
  assigned_electrician User?              @relation("AssignedElectrician", fields: [assigned_electrician_id], references: [id])
  assigned_plumber     User?              @relation("AssignedPlumber", fields: [assigned_plumber_id], references: [id])

  tender_line_items TenderLineItem[]
  penalties         UserPenalty[]

  @@map("complaints")
}

model CallState {
  id                   Int       @id @default(autoincrement())
  call_sid             String    @unique
  phase1_status        String    @default("pending")
  phase2_status        String    @default("pending")
  complaint_created    Boolean   @default(false)
  complaint_id         Int?
  phase1_voice_call_id Int?
  phase2_voice_call_id Int?
  finalized_at         DateTime?
  last_error           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([call_sid])
  @@map("call_state")
}

model SystemSettings {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

/**
 * Async ZIP export of resolved complaints + proof images (admin).
 */
model ExportJob {
  id                   Int       @id @default(autoincrement())
  created_by_user_id   Int
  org_unit_id          Int?
  electrician_user_id  Int
  range_from           DateTime
  range_to             DateTime
  status               String    @default("pending")
  result_relative_path String?
  error_message        String?
  row_count            Int?
  created_at           DateTime  @default(now())
  completed_at         DateTime?

  created_by  User     @relation("ExportJobCreator", fields: [created_by_user_id], references: [id])
  electrician User     @relation("ExportJobElectrician", fields: [electrician_user_id], references: [id])
  org_unit    OrgUnit? @relation(fields: [org_unit_id], references: [id])

  @@index([electrician_user_id])
  @@index([status])
  @@map("export_jobs")
}

// =====================================================================
//  TENDER WORKFLOW (Phase 1)
// =====================================================================

/**
 * Vendor master, panchayat-scoped. Phone is required and normalized to E.164.
 */
model Vendor {
  id          Int      @id @default(autoincrement())
  org_unit_id Int
  name        String
  phone_e164  String
  place       String?
  notes       String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  org_unit   OrgUnit              @relation(fields: [org_unit_id], references: [id])
  invites    TenderVendorInvite[]
  quotations TenderQuotation[]
  documents  TenderDocument[]

  @@unique([org_unit_id, phone_e164])
  @@index([org_unit_id])
  @@map("vendors")
}

/**
 * Top-level tender. Drives status machine, milestone rules, and document chain.
 */
model Tender {
  id                             Int       @id @default(autoincrement())
  org_unit_id                    Int
  status                         String    @default("draft")
  title_ta                       String?
  title_en                       String?
  narrative_ta                   String?
  narrative_en                   String?
  anchor_date                    DateTime?
  milestone_rules                Json?
  quotation_access_mode          String    @default("invited_only")
  auto_resolve_linked_complaints Boolean   @default(false)
  officer_self_inspection        Boolean   @default(false)
  public_token                   String?   @unique
  awarded_quotation_id           Int?      @unique
  work_order_date                DateTime?
  work_completed_at              DateTime?
  inspection_done_at             DateTime?
  inspection_notes               String?
  payment_meta                   Json?
  created_by_user_id             Int
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  org_unit              OrgUnit                    @relation(fields: [org_unit_id], references: [id])
  created_by            User                       @relation("TenderCreator", fields: [created_by_user_id], references: [id])
  awarded_quotation     TenderQuotation?           @relation("AwardedQuotation", fields: [awarded_quotation_id], references: [id])
  invites               TenderVendorInvite[]
  line_items            TenderLineItem[]
  quotations            TenderQuotation[]          @relation("TenderQuotations")
  documents             TenderDocument[]
  verification_sessions FieldVerificationSession[]
  checklist_items       TenderFieldChecklistItem[]
  audit_logs            TenderAuditLog[]

  @@index([org_unit_id, status])
  @@map("tenders")
}

/**
 * Vendor invitation join table for invited_only access mode.
 */
model TenderVendorInvite {
  id                  Int       @id @default(autoincrement())
  tender_id           Int
  vendor_id           Int
  invite_token        String?   @unique
  invite_expires_at   DateTime?
  invite_revoked_at   DateTime?
  invite_opened_at    DateTime?
  invite_submitted_at DateTime?
  created_at          DateTime  @default(now())

  tender Tender @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([tender_id, vendor_id])
  @@index([invite_token, invite_revoked_at])
  @@map("tender_vendor_invites")
}

/**
 * Per-line work item; may link to an electric pole and/or a complaint.
 */
model TenderLineItem {
  id             Int      @id @default(autoincrement())
  tender_id      Int
  seq            Int      @default(1)
  description_ta String?
  description_en String?
  quantity       Decimal? @db.Decimal(12, 3)
  unit           String?
  pole_id        Int?
  complaint_id   Int?

  tender          Tender                     @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  pole            ElectricPole?              @relation(fields: [pole_id], references: [id])
  complaint       Complaint?                 @relation(fields: [complaint_id], references: [id])
  checklist_items TenderFieldChecklistItem[]

  @@index([tender_id])
  @@map("tender_line_items")
}

/**
 * Bidder quotation. May come from public POST or officer offline entry.
 */
model TenderQuotation {
  id                   Int      @id @default(autoincrement())
  tender_id            Int
  vendor_id            Int?
  submitter_name       String
  submitter_phone_e164 String
  amount               Decimal  @db.Decimal(12, 2)
  remarks              String?
  attachment_url       String?
  source               String   @default("officer_entry")
  screening_outcome    String   @default("pending")
  superseded_by_id     Int?
  submitted_ip_hash    String?
  submitted_at         DateTime @default(now())

  tender             Tender            @relation("TenderQuotations", fields: [tender_id], references: [id], onDelete: Cascade)
  vendor             Vendor?           @relation(fields: [vendor_id], references: [id])
  superseded_by      TenderQuotation?  @relation("Superseded", fields: [superseded_by_id], references: [id])
  successors         TenderQuotation[] @relation("Superseded")
  awarded_for_tender Tender?           @relation("AwardedQuotation")

  @@index([tender_id])
  @@map("tender_quotations")
}

/**
 * Generated PDF artifact with version chain. status: pending|ready|failed.
 */
model TenderDocument {
  id                   Int       @id @default(autoincrement())
  tender_id            Int
  template_id          String
  vendor_id            Int?
  version              Int       @default(1)
  field_overrides      Json?
  storage_path         String?
  generated_at         DateTime?
  generated_by_user_id Int?
  status               String    @default("pending")
  error_message        String?
  created_at           DateTime  @default(now())

  tender       Tender  @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  vendor       Vendor? @relation(fields: [vendor_id], references: [id])
  generated_by User?   @relation("TenderDocGenerator", fields: [generated_by_user_id], references: [id])

  @@index([tender_id, template_id])
  @@map("tender_documents")
}

/**
 * Token-gated bucket for field-staff EXIF photo uploads.
 */
model FieldVerificationSession {
  id                 Int       @id @default(autoincrement())
  tender_id          Int
  token              String    @unique
  label              String?
  expires_at         DateTime?
  pole_subset_ids    Int[]     @default([])
  created_by_user_id Int
  confirmed_at       DateTime?
  created_at         DateTime  @default(now())

  tender     Tender                    @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  created_by User                      @relation("FieldSessionCreator", fields: [created_by_user_id], references: [id])
  uploads    FieldVerificationUpload[]

  @@index([tender_id])
  @@map("field_verification_sessions")
}

/**
 * Single image upload with EXIF + nearest-pole match result.
 */
model FieldVerificationUpload {
  id                   Int       @id @default(autoincrement())
  session_id           Int
  image_url            String
  exif_lat             Float?
  exif_lng             Float?
  captured_at          DateTime?
  ocr_lat              Float?
  ocr_lng              Float?
  ocr_address          String?
  ocr_raw_text         String?
  ocr_captured_at      DateTime?
  ocr_pole_number      String?
  ocr_keypad_id        String?
  ocr_matched_pole_id  Int?
  ocr_match_confidence String    @default("skipped")
  coord_source         String?
  matched_lat          Float?
  matched_lng          Float?
  matched_pole_id      Int?
  manual_pole_id       Int?
  distance_meters      Float?
  match_confidence     String    @default("unmatched")
  notes                String?
  uploaded_at          DateTime  @default(now())

  session         FieldVerificationSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  matched_pole    ElectricPole?              @relation("FieldUploadMatched", fields: [matched_pole_id], references: [id])
  manual_pole     ElectricPole?              @relation("FieldUploadManual", fields: [manual_pole_id], references: [id])
  checklist_items TenderFieldChecklistItem[]

  @@index([session_id])
  @@map("field_verification_uploads")
}

/**
 * Officer-facing checklist row per pole/line item; required for tender completion.
 */
model TenderFieldChecklistItem {
  id                 Int      @id @default(autoincrement())
  tender_id          Int
  pole_id            Int?
  line_item_id       Int?
  is_done            Boolean  @default(false)
  verified_upload_id Int?
  notes              String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tender          Tender                   @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  pole            ElectricPole?            @relation(fields: [pole_id], references: [id])
  line_item       TenderLineItem?          @relation(fields: [line_item_id], references: [id])
  verified_upload FieldVerificationUpload? @relation(fields: [verified_upload_id], references: [id])

  @@index([tender_id])
  @@map("tender_field_checklist_items")
}

/**
 * Append-only audit trail for tender state transitions and PDF generations.
 */
model TenderAuditLog {
  id            Int      @id @default(autoincrement())
  tender_id     Int
  actor_user_id Int?
  event         String
  payload       Json?
  created_at    DateTime @default(now())

  tender Tender @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  actor  User?  @relation("TenderAuditActor", fields: [actor_user_id], references: [id])

  @@index([tender_id])
  @@map("tender_audit_logs")
}

model WaterPipeline {
  id           Int      @id @default(autoincrement())
  name         String? // e.g., "Main Annur Conduit"
  org_unit_id  Int
  path_geojson Json // GeoJSON LineString for path rendering and GIS calculations
  diameter_mm  Float?
  material     String? // PVC, HDPE, Cast Iron
  status       String   @default("active") // active, leak_alert, maintenance
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  org_unit   OrgUnit        @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  flow_logs  WaterFlowLog[]
  complaints Complaint[]

  @@index([org_unit_id])
  @@map("water_pipelines")
}

model WaterTankBorewell {
  id                Int      @id @default(autoincrement())
  name              String // e.g., "Coimbatore Reservoir A"
  type              String // overhead_tank, borewell_pump
  latitude          Float
  longitude         Float
  org_unit_id       Int
  capacity_liters   Float?
  current_level_pct Float    @default(100.0) // 0 to 100
  status            String   @default("active") // active, empty, critical, maintenance
  pump_status       String? // on, off, faulty
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  org_unit   OrgUnit        @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  flow_logs  WaterFlowLog[]
  complaints Complaint[]

  @@index([org_unit_id])
  @@map("water_tank_borewells")
}

model WaterValve {
  id           Int      @id @default(autoincrement())
  valve_number String?
  latitude     Float
  longitude    Float
  org_unit_id  Int
  status       String   @default("open") // open, closed, maintenance
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@index([org_unit_id])
  @@map("water_valves")
}

model WaterFlowLog {
  id            BigInt   @id @default(autoincrement())
  pipeline_id   Int?
  tank_id       Int?
  flow_rate_lps Float // Liters per second
  pressure_bar  Float // Water pressure in bars
  logged_at     DateTime @default(now())

  pipeline WaterPipeline?     @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  tank     WaterTankBorewell? @relation(fields: [tank_id], references: [id], onDelete: Cascade)

  @@index([logged_at])
  @@map("water_flow_logs")
}

model CapturedAsset {
  id           Int      @id @default(autoincrement())
  type         String // household_tap, public_tap, main_pipeline
  material     String // PVC, HDPE, Cast Iron
  diameter_mm  Float
  latitude     Float
  longitude    Float
  photo_url    String?
  status       String   @default("pending_approval") // pending_approval, approved, rejected
  comment      String?
  agent_name   String
  device_model String?
  altitude     Float?
  precision    Float?
  submitted_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("captured_assets")
}

// =====================================================================
//  REVENUE GENERATION MODULES
// =====================================================================

/**
 * QR code ad campaign — shown when citizens scan pole QR codes.
 */
model AdCampaign {
  id                Int      @id @default(autoincrement())
  org_unit_id       Int
  advertiser_name   String
  advertiser_phone  String?
  title             String
  description       String?
  image_url         String?
  link_url          String?
  campaign_type     String   @default("standard") // basic, standard, premium
  target_zone_ids   Int[]    @default([])
  target_pole_ids   Int[]    @default([])
  amount_paid       Decimal  @db.Decimal(12, 2)
  starts_at         DateTime
  ends_at           DateTime
  is_active         Boolean  @default(true)
  total_impressions Int      @default(0)
  total_clicks      Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  org_unit    OrgUnit        @relation(fields: [org_unit_id], references: [id])
  impressions AdImpression[]

  @@index([org_unit_id, is_active])
  @@map("ad_campaigns")
}

/**
 * Tracks each QR scan impression and click for ad campaigns.
 */
model AdImpression {
  id          BigInt   @id @default(autoincrement())
  campaign_id Int
  pole_id     Int?
  device_ip   String?
  scanned_at  DateTime @default(now())
  clicked     Boolean  @default(false)

  campaign AdCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, scanned_at])
  @@map("ad_impressions")
}

/**
 * SLA rules per panchayat defining deadlines and penalty rates for workers.
 */
model PenaltyRule {
  id             Int      @id @default(autoincrement())
  org_unit_id    Int
  role           String // plumber, electrician
  urgency_level  String // low, medium, high, critical
  deadline_hours Int
  penalty_amount Decimal  @db.Decimal(12, 2)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@unique([org_unit_id, role, urgency_level])
  @@map("penalty_rules")
}

/**
 * Record of a penalty applied to a worker for SLA violation.
 */
model UserPenalty {
  id            Int      @id @default(autoincrement())
  user_id       Int
  complaint_id  Int
  amount        Decimal  @db.Decimal(12, 2)
  reason        String
  hours_delayed Float
  status        String   @default("pending") // pending, waived, deducted
  waived_reason String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  complaint Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([complaint_id])
  @@map("user_penalties")
}

/**
 * Registered property for house/property tax collection.
 */
model Property {
  id            Int      @id @default(autoincrement())
  org_unit_id   Int
  owner_name    String
  owner_phone   String?
  door_number   String?
  address       String?
  property_type String   @default("residential") // residential, commercial, vacant_land, industrial
  area_sqft     Float
  latitude      Float?
  longitude     Float?
  annual_tax    Decimal  @db.Decimal(12, 2)
  status        String   @default("active") // active, demolished, exempted
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  org_unit     OrgUnit      @relation(fields: [org_unit_id], references: [id])
  tax_payments TaxPayment[]

  @@unique([org_unit_id, door_number])
  @@index([org_unit_id])
  @@map("properties")
}

/**
 * Individual tax payment record per financial year.
 */
model TaxPayment {
  id              Int       @id @default(autoincrement())
  property_id     Int
  financial_year  String // "2025-26"
  demand_amount   Decimal   @db.Decimal(12, 2)
  penalty_amount  Decimal   @default(0) @db.Decimal(12, 2)
  paid_amount     Decimal   @default(0) @db.Decimal(12, 2)
  payment_method  String? // upi, razorpay, cash, bank_transfer
  transaction_ref String?
  paid_at         DateTime?
  receipt_url     String?
  status          String    @default("unpaid") // unpaid, partial, paid, overdue
  due_date        DateTime
  created_at      DateTime  @default(now())

  property Property @relation(fields: [property_id], references: [id])

  @@index([property_id, financial_year])
  @@map("tax_payments")
}

/**
 * Certificate or permit application from citizens.
 */
model CertificateRequest {
  id               Int       @id @default(autoincrement())
  org_unit_id      Int
  certificate_type String // birth, death, income, residence, trade_license, building_permit
  applicant_name   String
  applicant_phone  String?
  applicant_email  String?
  application_data Json?
  fee_amount       Decimal   @db.Decimal(10, 2)
  payment_status   String    @default("unpaid") // unpaid, paid
  payment_ref      String?
  review_status    String    @default("pending") // pending, approved, rejected
  reviewer_notes   String?
  certificate_url  String?
  certificate_qr   String?   @unique
  applied_at       DateTime  @default(now())
  reviewed_at      DateTime?
  issued_at        DateTime?

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id])

  @@index([org_unit_id, certificate_type])
  @@map("certificate_requests")
}

/**
 * OrgUnit-owned rentable asset (hall, ground, equipment).
 */
model PanchayatAsset {
  id             Int      @id @default(autoincrement())
  org_unit_id    Int
  name           String
  asset_type     String // hall, ground, equipment, vehicle
  description    String?
  daily_rate     Decimal  @db.Decimal(10, 2)
  hourly_rate    Decimal? @db.Decimal(10, 2)
  deposit_amount Decimal  @default(0) @db.Decimal(10, 2)
  max_capacity   Int?
  image_url      String?
  is_available   Boolean  @default(true)
  created_at     DateTime @default(now())

  org_unit OrgUnit        @relation(fields: [org_unit_id], references: [id])
  bookings AssetBooking[]

  @@index([org_unit_id])
  @@map("panchayat_assets")
}

/**
 * Booking record for a panchayat asset.
 */
model AssetBooking {
  id               Int       @id @default(autoincrement())
  asset_id         Int
  booked_by_name   String
  booked_by_phone  String
  event_type       String?
  start_date       DateTime
  end_date         DateTime
  total_amount     Decimal   @db.Decimal(10, 2)
  deposit_paid     Decimal   @default(0) @db.Decimal(10, 2)
  balance_amount   Decimal   @default(0) @db.Decimal(10, 2)
  payment_ref      String?
  booking_status   String    @default("pending") // pending, confirmed, cancelled, completed
  booking_token    String    @unique @default(uuid())
  cancelled_at     DateTime?
  cancellation_fee Decimal?  @db.Decimal(10, 2)
  created_at       DateTime  @default(now())

  asset PanchayatAsset @relation(fields: [asset_id], references: [id])

  @@index([asset_id, start_date, end_date])
  @@map("asset_bookings")
}

/**
 * Weekly/daily market definition.
 */
model MarketDay {
  id          Int     @id @default(autoincrement())
  org_unit_id Int
  name        String
  location    String?
  day_of_week Int // 0=Sun, 1=Mon, etc.
  daily_fee   Decimal @db.Decimal(8, 2)
  is_active   Boolean @default(true)

  org_unit        OrgUnit               @relation(fields: [org_unit_id], references: [id])
  vendor_payments MarketVendorPayment[]

  @@map("market_days")
}

/**
 * Registered market vendor with QR-based identification.
 */
model MarketVendor {
  id            Int      @id @default(autoincrement())
  org_unit_id   Int
  vendor_name   String
  vendor_phone  String
  business_type String?
  photo_url     String?
  vendor_token  String   @unique @default(uuid())
  is_active     Boolean  @default(true)
  registered_at DateTime @default(now())

  org_unit OrgUnit               @relation(fields: [org_unit_id], references: [id])
  payments MarketVendorPayment[]

  @@unique([org_unit_id, vendor_phone])
  @@map("market_vendors")
}

/**
 * Individual daily fee payment from a market vendor.
 */
model MarketVendorPayment {
  id             Int      @id @default(autoincrement())
  vendor_id      Int
  market_day_id  Int
  amount_paid    Decimal  @db.Decimal(8, 2)
  payment_method String   @default("cash")
  collected_by   String?
  paid_at        DateTime @default(now())

  vendor     MarketVendor @relation(fields: [vendor_id], references: [id])
  market_day MarketDay    @relation(fields: [market_day_id], references: [id])

  @@index([market_day_id, paid_at])
  @@map("market_vendor_payments")
}

// =====================================================================
//  PHASE 0 — CORE PLATFORM FOUNDATION
// =====================================================================

// ─────────────────────────────────────────────────────────────────────
//  0A. MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────

/**
 * Top-level customer/deployment isolation. Every row in the system is scoped to a tenant.
 */
model Tenant {
  id               String      @id // "tn_govt", "ap_govt", "demo"
  slug             String      @unique // url-safe client identifier, e.g. "madurai-corp"
  name             String // "Tamil Nadu Government"
  branch_type_hint BranchType? // what kind of client this is, used to default provisioning
  domain           String?     @unique // "tn.platform.gov.in"
  logo_url         String?
  config           Json? // Tenant-wide settings
  subscription     String      @default("enterprise") // free, starter, professional, enterprise
  max_branches     Int         @default(100)
  is_active        Boolean     @default(true)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  org_units         OrgUnit[]
  users             User[]
  employees         Employee[]
  roles             Role[]
  permission_groups PermissionGroup[]
  departments       Department[]
  feature_config    TenantFeatureConfig?

  @@map("tenants")
}

/**
 * Subscription-level feature ceiling for a tenant — the per-OrgUnit
 * BranchFeatureConfig may only enable a module if the tenant ceiling allows it.
 */
model TenantFeatureConfig {
  id        Int    @id @default(autoincrement())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  street_light_mgmt  Boolean @default(true)
  water_supply_mgmt  Boolean @default(true)
  complaint_mgmt     Boolean @default(true)
  tender_mgmt        Boolean @default(true)
  certificate_mgmt   Boolean @default(true)
  market_mgmt        Boolean @default(true)
  asset_booking      Boolean @default(true)
  ad_campaign        Boolean @default(true)
  penalty_mgmt       Boolean @default(true)
  ivr_system         Boolean @default(true)
  zone_management    Boolean @default(true)
  solid_waste_mgmt   Boolean @default(true)
  drainage_mgmt      Boolean @default(true)
  road_mgmt          Boolean @default(true)
  parks_mgmt         Boolean @default(true)
  public_health      Boolean @default(true)
  building_permit    Boolean @default(true)
  birth_death_reg    Boolean @default(true)
  vehicle_fleet_mgmt Boolean @default(true)
  cemetery_mgmt      Boolean @default(true)
  encroachment_mgmt  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tenant_feature_configs")
}

// ─────────────────────────────────────────────────────────────────────
//  0B. BRANCH FEATURE CONFIG & LIFECYCLE
// ─────────────────────────────────────────────────────────────────────

/**
 * Feature toggles per branch — Super Admin controls which modules are available.
 */
model BranchFeatureConfig {
  id          Int @id @default(autoincrement())
  org_unit_id Int @unique

  // Existing module toggles
  street_light_mgmt Boolean @default(true)
  water_supply_mgmt Boolean @default(false)
  complaint_mgmt    Boolean @default(true)
  tender_mgmt       Boolean @default(false)
  certificate_mgmt  Boolean @default(false)
  market_mgmt       Boolean @default(false)
  asset_booking     Boolean @default(false)
  ad_campaign       Boolean @default(false)
  penalty_mgmt      Boolean @default(false)
  ivr_system        Boolean @default(false)
  zone_management   Boolean @default(true)

  // New municipality modules
  solid_waste_mgmt   Boolean @default(false)
  drainage_mgmt      Boolean @default(false)
  road_mgmt          Boolean @default(false)
  parks_mgmt         Boolean @default(false)
  public_health      Boolean @default(false)
  building_permit    Boolean @default(false)
  birth_death_reg    Boolean @default(false)
  vehicle_fleet_mgmt Boolean @default(false)
  cemetery_mgmt      Boolean @default(false)
  encroachment_mgmt  Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@map("branch_feature_configs")
}

/**
 * Tracks every branch status change — creation, merge, upgrade, close.
 */
model BranchLifecycleEvent {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int
  event_type     String // "created", "activated", "deactivated", "merged", "upgraded", "closed", "transferred"
  from_status    String?
  to_status      String
  details        Json? // { merged_from: [3,4], reason: "District reorganization" }
  effective_date DateTime
  performed_by   Int?
  created_at     DateTime @default(now())

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("branch_lifecycle_events")
}

// ─────────────────────────────────────────────────────────────────────
//  0C. EMPLOYEE & RBAC
// ─────────────────────────────────────────────────────────────────────

/**
 * Government employee identity — separate from User login. Tracks service history, cadre, designation.
 */
model Employee {
  id                  Int       @id @default(autoincrement())
  tenant_id           String
  user_id             Int       @unique
  employee_code       String // Auto-generated: "EMP-00042"
  service_book_number String? // Government service book reference
  org_unit_id         Int // Current posting (denormalized cache — authoritative scoping lives on UserRole)
  department_id       Int? // References Department model
  designation         String? // "Municipal Engineer", "AE", "Panchayat Secretary"
  hierarchy_level     Int? // 1=top authority ... higher number = lower rank
  cadre               String? // "TNCS", "TNMS", "TNES"
  date_of_joining     DateTime?
  date_of_retirement  DateTime?
  reporting_to_id     Int? // Direct supervisor's employee ID
  pay_level           String?
  qualification       String?
  photo_url           String?
  status              String    @default("active") // active, on_leave, transferred, retired, suspended
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user         User        @relation(fields: [user_id], references: [id])
  tenant       Tenant      @relation(fields: [tenant_id], references: [id])
  org_unit     OrgUnit     @relation(fields: [org_unit_id], references: [id])
  department   Department? @relation(fields: [department_id], references: [id])
  reporting_to Employee?   @relation("ReportsTo", fields: [reporting_to_id], references: [id])
  reports      Employee[]  @relation("ReportsTo")

  @@unique([tenant_id, employee_code])
  @@index([tenant_id, org_unit_id])
  @@map("employees")
}

/**
 * Atomic permission — "complaints.read", "assets.approve".
 */
model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique // "complaints.read", "assets.approve"
  module      String // "complaints", "assets"
  action      String // "read", "write", "approve", "delete", "export"
  description String?

  @@map("permissions")
}

/**
 * Named group of permissions — "Engineering Full Access".
 */
model PermissionGroup {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  tenant      Tenant @relation(fields: [tenant_id], references: [id])
  name        String // "Engineering Full Access"
  permissions Json // Array of permission codes

  @@unique([tenant_id, name])
  @@map("permission_groups")
}

/**
 * Role definition with hierarchy level and inheritance.
 */
model Role {
  id                    Int      @id @default(autoincrement())
  tenant_id             String // "__system__" for global designation templates, else a real Tenant.id
  org_unit_id           Int? // null = tenant-wide role template
  name                  String // "municipal_engineer" — single merged vocabulary, matches @Roles() decorators
  display_name          String // "Municipal Engineer"
  display_name_ta       String? // "நகராட்சி பொறியாளர்"
  department            String?
  hierarchy_level       Int      @default(5)
  permission_group_id   Int?
  inherits_from_role_id Int? // Role inheritance chain
  is_super_admin        Boolean  @default(false) // replaces hardcoded role==='super_admin' string checks
  can_approve           Boolean  @default(false)
  is_system             Boolean  @default(false) // System roles can't be deleted
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())

  tenant        Tenant     @relation(fields: [tenant_id], references: [id])
  org_unit      OrgUnit?   @relation(fields: [org_unit_id], references: [id])
  inherits_from Role?      @relation("RoleInheritance", fields: [inherits_from_role_id], references: [id])
  inherited_by  Role[]     @relation("RoleInheritance")
  user_roles    UserRole[]

  @@unique([tenant_id, org_unit_id, name])
  @@map("roles")
}

/**
 * Links a user to a role at a specific org unit (and optionally department).
 * The single authoritative scoping record — supersedes User.org_unit_id and
 * Employee.access_scope for authorization purposes. Supports temporary permissions.
 */
model UserRole {
  id            Int       @id @default(autoincrement())
  user_id       Int
  role_id       Int
  org_unit_id   Int // Which org unit this role applies to
  department_id Int? // Optional department scoping within the org unit
  access_scope  String    @default("own_org_unit") // own_org_unit, child_org_units, all_org_units
  is_primary    Boolean   @default(false) // the user's default/login context
  is_temporary  Boolean   @default(false)
  valid_from    DateTime  @default(now())
  valid_until   DateTime? // Temporary permission expiry
  granted_by    Int?
  created_at    DateTime  @default(now())

  user       User        @relation(fields: [user_id], references: [id])
  role       Role        @relation(fields: [role_id], references: [id])
  org_unit   OrgUnit     @relation(fields: [org_unit_id], references: [id])
  department Department? @relation(fields: [department_id], references: [id])

  @@unique([user_id, role_id, org_unit_id, department_id])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────
//  0D. DEPARTMENTS
// ─────────────────────────────────────────────────────────────────────

/**
 * Organizational department within a branch.
 */
model Department {
  id               Int     @id @default(autoincrement())
  tenant_id        String
  org_unit_id      Int
  code             String // "engineering", "health", "revenue"
  name             String // "Engineering Department"
  name_ta          String? // "பொறியியல் துறை"
  parent_id        Int? // For sub-departments
  head_employee_id Int? // Department head
  display_order    Int     @default(0)
  is_active        Boolean @default(true)

  tenant     Tenant       @relation(fields: [tenant_id], references: [id])
  org_unit   OrgUnit      @relation(fields: [org_unit_id], references: [id])
  parent     Department?  @relation("DeptHierarchy", fields: [parent_id], references: [id])
  children   Department[] @relation("DeptHierarchy")
  employees  Employee[]
  user_roles UserRole[]

  @@unique([tenant_id, org_unit_id, code])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────
//  0E. NUMBER GENERATION
// ─────────────────────────────────────────────────────────────────────

/**
 * Central sequence generator — configurable format per entity type.
 */
model SequenceConfig {
  id            Int       @id @default(autoincrement())
  tenant_id     String
  org_unit_id   Int? // null = tenant-wide
  entity_type   String // "complaint", "work_order", "asset"
  prefix        String // "CMP", "WO", "AST"
  format        String // "{prefix}-{fy}-{seq:6}" → "CMP-2026-000001"
  current_seq   Int       @default(0)
  reset_cycle   String?   @default("financial_year") // financial_year, calendar_year, never
  last_reset_at DateTime?

  @@unique([tenant_id, org_unit_id, entity_type])
  @@map("sequence_configs")
}

// ─────────────────────────────────────────────────────────────────────
//  0F. WORKING CALENDAR, HOLIDAYS & SLA
// ─────────────────────────────────────────────────────────────────────

/**
 * Working calendar — supports multiple per tenant (office, emergency 24×7, sanitation shift).
 */
model WorkingCalendar {
  id                  Int     @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int? // null = tenant-wide default
  name                String // "Standard Government Calendar", "Emergency 24x7"
  working_days        Int[]   @default([1, 2, 3, 4, 5, 6]) // 1=Mon..6=Sat
  working_hours_start String  @default("09:30")
  working_hours_end   String  @default("17:45")
  half_day_hours_end  String? @default("13:00")
  is_default          Boolean @default(false)

  @@index([tenant_id, org_unit_id])
  @@map("working_calendars")
}

/**
 * Holiday definitions — government holidays, state holidays, local holidays.
 */
model Holiday {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int? // null = tenant-wide
  date         DateTime @db.Date
  name         String // "Republic Day"
  name_ta      String? // "குடியரசு தினம்"
  holiday_type String // "national", "state", "local", "restricted", "half_day"
  is_active    Boolean  @default(true)

  @@unique([tenant_id, org_unit_id, date])
  @@map("holidays")
}

/**
 * SLA policy defining resolution targets per entity type and urgency.
 */
model SlaPolicy {
  id               Int      @id @default(autoincrement())
  tenant_id        String
  org_unit_id      Int?
  entity_type      String // "complaint", "building_permit"
  category         String? // "electrical", "plumbing"
  urgency_level    String? // "low", "medium", "high", "critical"
  target_hours     Int // Business hours target
  warning_hours    Int
  escalation_hours Int
  breach_hours     Int
  escalation_role  String?
  is_24x7          Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  @@unique([tenant_id, org_unit_id, entity_type, category, urgency_level])
  @@map("sla_policies")
}

/**
 * Live SLA tracker for an individual entity (complaint, permit, etc.).
 */
model SlaTracker {
  id                   Int       @id @default(autoincrement())
  tenant_id            String
  entity_type          String
  entity_id            Int
  sla_policy_id        Int
  started_at           DateTime  @default(now())
  target_at            DateTime
  warning_at           DateTime
  escalation_at        DateTime
  breach_at            DateTime
  paused_at            DateTime?
  resumed_at           DateTime?
  resolved_at          DateTime?
  total_paused_hours   Float     @default(0)
  status               String    @default("on_track") // on_track, warning, escalated, breached, resolved
  delay_reason         String?
  escalated_to_user_id Int?

  @@index([tenant_id, entity_type, entity_id])
  @@index([status, target_at])
  @@map("sla_trackers")
}

// ─────────────────────────────────────────────────────────────────────
//  0G. AUDIT TRAIL
// ─────────────────────────────────────────────────────────────────────

/**
 * Immutable audit log — captures before/after values on every data mutation.
 */
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int?
  user_id        Int?
  module         String // "complaints", "assets"
  entity_type    String // "Complaint", "Asset"
  entity_id      String // "42"
  action         String // "create", "update", "delete", "approve", "login"
  before_value   Json?
  after_value    Json?
  changed_fields String[] @default([])
  device_info    String?
  ip_address     String?
  user_agent     String?
  session_id     String?
  created_at     DateTime @default(now())

  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, user_id, created_at])
  @@index([tenant_id, module, created_at])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────
//  0H. NOTIFICATION ENGINE
// ─────────────────────────────────────────────────────────────────────

/**
 * Notification template with language support.
 */
model NotificationTemplate {
  id            Int     @id @default(autoincrement())
  tenant_id     String
  code          String // "complaint_assigned", "sla_warning"
  channel       String // "whatsapp", "sms", "email", "push", "in_app"
  subject       String?
  body_template String // "Hi {{name}}, complaint #{{id}} assigned."
  language      String  @default("en")
  is_active     Boolean @default(true)

  @@unique([tenant_id, code, channel, language])
  @@map("notification_templates")
}

/**
 * Individual notification with delivery tracking.
 */
model Notification {
  id                BigInt    @id @default(autoincrement())
  tenant_id         String
  recipient_user_id Int?
  recipient_phone   String?
  recipient_email   String?
  template_code     String
  channel           String
  variables         Json?
  rendered_body     String?
  status            String    @default("queued") // queued, sending, sent, failed, read
  retry_count       Int       @default(0)
  max_retries       Int       @default(3)
  error_message     String?
  scheduled_for     DateTime?
  sent_at           DateTime?
  read_at           DateTime?
  created_at        DateTime  @default(now())

  @@index([tenant_id, recipient_user_id, status])
  @@index([status, created_at])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────
//  0I. DOCUMENT MANAGEMENT SYSTEM
// ─────────────────────────────────────────────────────────────────────

/**
 * Folder hierarchy for organizing documents.
 */
model DocumentFolder {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  name        String
  parent_id   Int?
  created_at  DateTime @default(now())

  parent   DocumentFolder?  @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children DocumentFolder[] @relation("FolderHierarchy")

  @@map("document_folders")
}

/**
 * Document with versioning, tagging, digital signature, and expiry.
 */
model Document {
  id                Int       @id @default(autoincrement())
  tenant_id         String
  org_unit_id       Int
  folder_id         Int?
  title             String
  file_name         String
  storage_key       String // Provider-agnostic (S3, local, etc.)
  file_url          String?
  file_size_bytes   BigInt?
  mime_type         String?
  version           Int       @default(1)
  parent_doc_id     Int? // Previous version link
  tags              String[]  @default([])
  module            String? // "complaints", "tenders"
  entity_type       String?
  entity_id         Int?
  digital_signature Json? // { signer, signed_at, cert_hash }
  expires_at        DateTime?
  uploaded_by       Int
  created_at        DateTime  @default(now())

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by Int?

  @@index([tenant_id, org_unit_id, module])
  @@index([tenant_id, entity_type, entity_id])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────
//  0J. POLYMORPHIC COMMENTS
// ─────────────────────────────────────────────────────────────────────

/**
 * Reusable comment system — works across complaints, assets, tenders, inspections.
 */
model Comment {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  entity_type    String // "complaint", "asset", "work_order", "tender"
  entity_id      Int
  user_id        Int
  body           String
  attachment_url String?
  is_internal    Boolean  @default(true) // Internal note vs public-facing
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  @@index([tenant_id, entity_type, entity_id])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────
//  0K. WORKFLOW ENGINE (with versioning + conditional rules)
// ─────────────────────────────────────────────────────────────────────

/**
 * Workflow definition for a branch — versioned so in-progress workflows aren't broken.
 */
model WorkflowTemplate {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  name        String // "complaint_resolution", "work_order_approval"
  description String?
  department  String?
  version     Int      @default(1)
  status      String   @default("draft") // draft, published, archived
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  org_unit  OrgUnit            @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  rules     WorkflowRule[]
  instances WorkflowInstance[]

  @@unique([org_unit_id, name, version])
  @@map("workflow_templates")
}

/**
 * Individual step in a workflow approval chain.
 */
model WorkflowStep {
  id                  Int     @id @default(autoincrement())
  template_id         Int
  step_order          Int
  role_name           String // "commissioner", "me", "ae", "je"
  action_type         String // "review", "approve", "execute", "verify", "notify"
  is_required         Boolean @default(true)
  auto_escalate_hours Int?
  sla_hours           Int?

  template WorkflowTemplate     @relation(fields: [template_id], references: [id], onDelete: Cascade)
  actions  WorkflowStepAction[]
  rules    WorkflowRule[]

  @@unique([template_id, step_order])
  @@map("workflow_steps")
}

/**
 * Conditional routing rules — amount-based, urgency-based, department-based.
 */
model WorkflowRule {
  id              Int     @id @default(autoincrement())
  template_id     Int
  step_id         Int
  condition_field String // "estimated_cost", "urgency_level"
  condition_op    String // "gt", "lt", "eq", "in", "between"
  condition_value Json
  then_action     String // "skip_step", "add_step", "route_to_role"
  then_value      String?
  priority        Int     @default(1)

  template WorkflowTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [step_id], references: [id])

  @@map("workflow_rules")
}

/**
 * A running instance of a workflow for a specific entity (complaint, work order, etc.).
 */
model WorkflowInstance {
  id                 Int       @id @default(autoincrement())
  tenant_id          String
  template_id        Int
  entity_type        String // "complaint", "work_order", "tender"
  entity_id          Int
  current_step_order Int       @default(1)
  status             String    @default("in_progress") // in_progress, completed, rejected, escalated
  started_at         DateTime  @default(now())
  completed_at       DateTime?

  template WorkflowTemplate     @relation(fields: [template_id], references: [id])
  actions  WorkflowStepAction[]

  @@index([tenant_id, entity_type, entity_id])
  @@map("workflow_instances")
}

/**
 * Log of each approval action taken in a workflow.
 */
model WorkflowStepAction {
  id            Int      @id @default(autoincrement())
  instance_id   Int
  step_id       Int
  actor_user_id Int?
  action        String // "approved", "rejected", "escalated", "returned", "executed"
  comments      String?
  acted_at      DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [step_id], references: [id])

  @@map("workflow_step_actions")
}

// ─────────────────────────────────────────────────────────────────────
//  0L. INTEGRATION FRAMEWORK
// ─────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────
//  0M. CONFIG, LOCALIZATION & SCHEDULING
// ─────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────
//  0N. GENERIC ASSET MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

/**
 * Generic asset — electric poles, water tanks, borewells, transformers, parks, etc.
 */
model Asset {
  id              Int     @id @default(autoincrement())
  tenant_id       String
  org_unit_id     Int
  asset_type_code String // References MasterValue code: "electric_pole", "water_tank"
  asset_uuid      String  @unique @default(uuid()) // Immutable internal ID
  asset_code      String? // Human-readable, can change: "SL-MDU-Z3-042"
  name            String?

  // Location
  latitude  Float?
  longitude Float?
  zone_id   Int?
  address   String?
  landmarks String[] @default([])

  // Lifecycle
  installed_at      DateTime?
  manufacturer      String?
  model_number      String?
  serial_number     String?
  condition_rating  Int?      @default(5)
  is_operational    Boolean   @default(true)
  decommissioned_at DateTime?

  // Type-specific data (flexible schema)
  custom_data Json? // { "wattage": 100, "pole_type": "steel", "height_m": 8.5 }

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  images AssetImage[]

  @@index([tenant_id, org_unit_id, asset_type_code])
  @@index([asset_uuid])
  @@map("assets")
}

/**
 * Asset photo with enhanced metadata for field verification.
 */
model AssetImage {
  id          Int     @id @default(autoincrement())
  asset_id    Int
  storage_key String
  image_url   String?
  image_type  String // "installation", "current", "damage", "repair"
  caption     String?

  // Enhanced metadata
  file_size_bytes Int?
  resolution      String? // "1920x1080"
  captured_device String?
  exif_data       Json?
  gps_lat         Float?
  gps_lng         Float?
  gps_accuracy_m  Float?

  captured_at DateTime?
  uploaded_by Int?
  uploaded_at DateTime  @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@map("asset_images")
}

// ─────────────────────────────────────────────────────────────────────
//  0O. CONTRACTOR & WORK ORDER MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

/**
 * Contractor master — registered contractors for municipal works.
 */
model Contractor {
  id                  Int      @id @default(autoincrement())
  tenant_id           String
  name                String
  phone               String
  email               String?
  gst_number          String?
  pan_number          String?
  registration_number String?
  category            String[] @default([]) // ["electrical", "civil", "plumbing"]
  rating              Float?
  blacklisted         Boolean  @default(false)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())

  work_orders WorkOrder[]

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  @@index([tenant_id])
  @@map("contractors")
}

/**
 * Formal work order issued to a contractor or municipal maintenance team.
 */
model WorkOrder {
  id                  Int       @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int
  work_order_number   String? // Auto-generated via SequenceConfig
  contractor_id       Int?
  tender_id           Int?
  title               String
  description         String?
  estimated_cost      Decimal?  @db.Decimal(14, 2)
  actual_cost         Decimal?  @db.Decimal(14, 2)
  status              String    @default("draft") // draft, issued, in_progress, completed, verified, paid
  issued_at           DateTime?
  start_date          DateTime?
  expected_completion DateTime?
  actual_completion   DateTime?
  completion_cert_url String?
  measurement_book    Json? // [{ desc, qty, unit, rate, amount }]
  financial_year_code String? // "2025-26"
  created_by          Int
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  contractor Contractor? @relation(fields: [contractor_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("work_orders")
}

// ─────────────────────────────────────────────────────────────────────
//  0P. CITIZEN PORTAL
// ─────────────────────────────────────────────────────────────────────

/**
 * Citizen profile linked to a user account.
 */
model CitizenProfile {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  user_id     Int      @unique
  full_name   String
  phone       String
  email       String?
  address     String?
  ward        String?
  org_unit_id Int
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("citizen_profiles")
}

/**
 * Public announcements from a branch to citizens.
 */
model Announcement {
  id           Int       @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int
  title        String
  title_ta     String?
  body         String
  body_ta      String?
  category     String? // "general", "water", "road", "event"
  is_pinned    Boolean   @default(false)
  published_at DateTime  @default(now())
  expires_at   DateTime?
  created_by   Int

  @@index([tenant_id, org_unit_id])
  @@map("announcements")
}

/**
 * Citizen feedback/rating for services.
 */
model CitizenFeedback {
  id              Int      @id @default(autoincrement())
  tenant_id       String
  org_unit_id     Int
  citizen_user_id Int?
  entity_type     String? // "complaint", "service"
  entity_id       Int?
  rating          Int // 1-5
  comment         String?
  created_at      DateTime @default(now())

  @@index([tenant_id, org_unit_id])
  @@map("citizen_feedback")
}

// ─────────────────────────────────────────────────────────────────────
//  0Q. FIELD INSPECTION MODULE
// ─────────────────────────────────────────────────────────────────────

/**
 * Reusable inspection template with checklist items.
 */
model InspectionTemplate {
  id              Int     @id @default(autoincrement())
  tenant_id       String
  name            String
  asset_type_code String? // null = any asset type
  checklist_items Json // [{ item: "Wiring intact", type: "yes_no" }]
  is_active       Boolean @default(true)

  @@map("inspection_templates")
}

/**
 * Individual field inspection record with GPS, photos, signature.
 */
model FieldInspection {
  id                Int      @id @default(autoincrement())
  tenant_id         String
  org_unit_id       Int
  template_id       Int?
  inspector_user_id Int
  asset_id          Int?
  location_lat      Float?
  location_lng      Float?
  gps_locked        Boolean  @default(false)
  gps_accuracy_m    Float?
  checklist_results Json?
  overall_score     Int?
  photos            Json?
  signature_url     String?
  remarks           String?
  status            String   @default("completed")
  inspected_at      DateTime @default(now())

  @@index([tenant_id, org_unit_id])
  @@map("field_inspections")
}

// ─────────────────────────────────────────────────────────────────────
//  0R. DASHBOARD & REPORTING ENGINE
// ─────────────────────────────────────────────────────────────────────

/**
 * Configurable dashboard widget definition.
 */
model DashboardWidget {
  id           Int     @id @default(autoincrement())
  tenant_id    String
  code         String
  title        String
  widget_type  String // "counter", "pie_chart", "bar_chart", "table", "map", "kpi"
  data_source  String
  query_config Json
  default_size String  @default("medium")
  is_active    Boolean @default(true)

  @@unique([tenant_id, code])
  @@map("dashboard_widgets")
}

/**
 * Role-specific dashboard layout.
 */
model RoleDashboard {
  id         Int    @id @default(autoincrement())
  tenant_id  String
  role_name  String
  widget_ids Int[]
  layout     Json?

  @@unique([tenant_id, role_name])
  @@map("role_dashboards")
}

/**
 * Saved report with optional scheduling.
 */
model SavedReport {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int?
  name           String
  report_type    String
  format         String    @default("pdf") // pdf, excel, csv
  filters        Json?
  schedule_cron  String?
  email_to       String[]  @default([])
  last_generated DateTime?
  created_by     Int
  created_at     DateTime  @default(now())

  @@map("saved_reports")
}

// ─────────────────────────────────────────────────────────────────────
//  0S. DYNAMIC FORM BUILDER
// ─────────────────────────────────────────────────────────────────────

/**
 * Dynamic form template — complaint form, building permit, birth registration.
 */
model FormTemplate {
  id         Int      @id @default(autoincrement())
  tenant_id  String
  code       String
  name       String
  name_ta    String?
  module     String
  version    Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  fields FormField[]

  @@unique([tenant_id, code, version])
  @@map("form_templates")
}

/**
 * Individual field in a dynamic form.
 */
model FormField {
  id            Int     @id @default(autoincrement())
  template_id   Int
  field_key     String
  field_type    String // "text", "number", "date", "select", "file", "gps", "photo", "signature"
  label         String
  label_ta      String?
  placeholder   String?
  options       Json? // For select fields
  validation    Json? // { required: true, min: 0, max: 100 }
  display_order Int
  section       String?
  visible_when  Json? // Conditional visibility
  is_required   Boolean @default(false)

  template FormTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("form_fields")
}

/**
 * Submitted form data linked to an entity.
 */
model FormSubmission {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int
  template_id  Int
  submitted_by Int?
  data         Json
  status       String   @default("submitted")
  entity_type  String?
  entity_id    Int?
  submitted_at DateTime @default(now())

  @@index([tenant_id, org_unit_id, template_id])
  @@map("form_submissions")
}
