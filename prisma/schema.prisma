  booking_status   String    @default("pending") // pending, confirmed, cancelled, completed
  booking_token    String    @unique @default(uuid())
  cancelled_at     DateTime?
  cancellation_fee Decimal?  @db.Decimal(10, 2)
  created_at       DateTime  @default(now())

