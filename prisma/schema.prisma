  facility_id      Int
  booked_by_name   String
  booked_by_phone  String
  event_type       String?
  start_date       DateTime
  end_date         DateTime
  total_amount     Decimal   @db.Decimal(10, 2)
  deposit_paid     Decimal   @default(0) @db.Decimal(10, 2)
