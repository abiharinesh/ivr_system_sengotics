generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// =====================================================================
//  ENUMS — Branch types & statuses for all TN local bodies
// =====================================================================

enum BranchType {
  VILLAGE_PANCHAYAT
  PANCHAYAT_UNION
  DISTRICT_PANCHAYAT
  TOWN_PANCHAYAT
  MUNICIPALITY
  MUNICIPAL_CORPORATION
}

enum BranchStatus {
  DRAFT
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  MERGED
  UPGRADED
  CLOSED
}

model IvrCall {
  call_sid          String    @id
  caller_number     String?
  call_to           String?
  flow_id           String?
  tenant_id         String?
  call_start_time   DateTime?
  call_end_time     DateTime?
  service_selected  Boolean   @default(false)
  poll_entered      Boolean   @default(false)
  final_call_status String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  service_selections IvrServiceSelection[]
  poll_inputs        IvrPollInput[]

  @@map("ivr_calls")
}

model IvrServiceSelection {
  id             BigInt   @id @default(autoincrement())
  call_sid       String
  caller_number  String?
  service_option String?
  received_at    DateTime @default(now())
  raw_payload    Json?

  call IvrCall @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_service_selections")
}

model IvrPollInput {
  id            BigInt   @id @default(autoincrement())
  call_sid      String
  caller_number String?
  poll_id       String?
  received_at   DateTime @default(now())
  raw_payload   Json?

  call IvrCall @relation(fields: [call_sid], references: [call_sid])

  @@map("ivr_poll_inputs")
}

model VoiceCall {
  id                 Int      @id @default(autoincrement())
  call_sid           String?
  audio_url          String?
  transcript         String?
  transcript_english String?
  ai_extracted_json  Json?
  processing_status  String   @default("pending")
  confidence_score   Float?
  attempt_number     Int      @default(1)
  created_at         DateTime @default(now())

  complaints Complaint[]

  @@unique([call_sid, audio_url])
  @@index([call_sid, attempt_number])
  @@map("voice_calls")
}

model OrgUnit {
  id                         Int                                     @id @default(autoincrement())
  name                       String
  boundary                   Unsupported("geometry(Polygon, 4326)")?
  center_lat                 Float?
  center_lng                 Float?
  ivr_number                 String?                                 @unique
  document_template_settings Json?

  // ── Multi-tenant ──
  tenant_id String @default("default")
  tenant    Tenant @relation(fields: [tenant_id], references: [id])

  // ── Branch classification ──
  branch_type        BranchType   @default(VILLAGE_PANCHAYAT)
  branch_status      BranchStatus @default(ACTIVE)
  branch_code        String?      @unique
  parent_org_unit_id Int?

  // Escalation target for complaints/requests that leave the body. Kept as a
  // plain reference; the AdminJurisdiction lookup table it used to point at
  // had zero readers in backend or frontend and was dropped.
  escalation_jurisdiction_id Int?

  // ── Lifecycle ──
  effective_from    DateTime  @default(now())
  effective_until   DateTime?
  merged_into_id    Int?
  upgraded_to_id    Int?
  status_changed_at DateTime?
  status_changed_by Int?
  status_reason     String?

  // ── Geography ──
  district       String?
  taluk          String?
  block          String?
  village        String?
  ward_count     Int?
  survey_numbers String[] @default([])
  gis_boundary   Json?
  area_sq_km     Float?

  // ── Contact & Branding ──
  contact_phone       String?
  contact_email       String?
  address             String?
  logo_url            String?
  secondary_logo_url  String?
  favicon_url         String?
  software_name_ta    String? @default("ஊராட்சி குரல்")
  software_name_en    String? @default("Ooratchi Kural")
  software_tagline_ta String? @default("குடிமக்கள் சேவை மையம்")
  software_tagline_en String? @default("Citizen Service Portal")
  primary_color       String? @default("#1E3A8A")
  secondary_color     String? @default("#0EA5E9")
  welcome_audio_url   String?
  state_code          String? @default("TN")

  // ── Soft delete ──
  is_active  Boolean   @default(true)
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  // ── Self-relation: org unit hierarchy (District → Union → Village) ──
  parent_org_unit OrgUnit?  @relation("OrgUnitHierarchy", fields: [parent_org_unit_id], references: [id])
  child_org_units OrgUnit[] @relation("OrgUnitHierarchy")

  // ── Existing relations ──
  electric_poles  ElectricPole[]
  water_pipelines WaterPipeline[]
  water_tanks     WaterTankBorewell[]
  water_valves    WaterValve[]
  captured_assets AssetFieldCapture[]
  complaints      Complaint[]
  users           User[]
  export_jobs     ExportJob[]
  contractors     Contractor[]
  tenders         Tender[]
  zones           Zone[]

  // Revenue module relations
  ad_campaigns          AdCampaign[]
  penalty_rules         PenaltyRule[]
  tax_properties        TaxProperty[]
  certificate_requests  CertificateRequest[]
  bookable_facilities   BookableFacility[]
  market_days           MarketDay[]
  market_vendors        MarketVendor[]
  building_permits      BuildingPermit[]
  vital_events          VitalEvent[]
  waste_bins            WasteBin[]
  trade_licences        TradeLicence[]
  collection_routes     CollectionRoute[]
  collection_trips      CollectionTrip[]
  sanitation_attendance SanitationAttendance[]

  // ── New platform relations ──
  feature_config     BranchFeatureConfig?
  roles              Role[]
  workflow_templates WorkflowTemplate[]
  departments        Department[]
  employees          Employee[]
  lifecycle_events   BranchLifecycleEvent[]
  userRoles          UserRole[]

  @@index([tenant_id])
  @@index([tenant_id, branch_type])
  @@index([parent_org_unit_id])
  @@index([escalation_jurisdiction_id])
  @@map("org_units")
}

/**
 * An admin-drawn geographic zone within an org unit.
 */
model Zone {
  id               Int      @id @default(autoincrement())
  org_unit_id      Int
  name             String
  boundary_geojson Json // GeoJSON Polygon/MultiPolygon
  color            String?  @default("#2563EB")
  opacity          Float    @default(0.3)
  places           String[] @default([])
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  org_unit          OrgUnit           @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  assets            Asset[]
  waste_bins        WasteBin[]
  collection_routes CollectionRoute[]

  @@index([org_unit_id])
  @@map("zones")
}

model User {
  id                  Int      @id @default(autoincrement())
  tenant_id           String   @default("default")
  email               String?
  password_hash       String
  role                String   @default("panchayat_admin")
  primary_org_unit_id Int? // login/home context — the one org unit a user lands on; multi-role scoping lives on UserRole
  phone_e164          String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  // ── Identity & Classification ──
  user_type   String  @default("employee") // employee, citizen, contractor, system
  is_active   Boolean @default(true)
  is_verified Boolean @default(false)

  // ── Login tracking ──
  last_login_at     DateTime?
  last_login_ip     String?
  last_login_device String?
  failed_attempts   Int       @default(0)
  locked_until      DateTime?

  /// Set on every seeded account. Login succeeds but the client must send the
  /// user to a change-password screen before anything else — a provisioned
  /// account with a known temporary password is not a usable account.
  must_change_password Boolean   @default(false)
  password_changed_at  DateTime?

  // ── Soft delete ──
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by Int?

  // ── Existing relations ──
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id])
  primary_org_unit       OrgUnit?       @relation(fields: [primary_org_unit_id], references: [id])
  assigned_complaints    Complaint[]    @relation("AssignedElectrician")
  assigned_plumbing_jobs Complaint[]    @relation("AssignedPlumber")
  pole_image_uploads     ElectricPole[] @relation("PoleImageUploader")

  export_jobs_created    ExportJob[] @relation("ExportJobCreator")
  export_jobs_as_subject ExportJob[] @relation("ExportJobElectrician")

  tenders_created        Tender[]                   @relation("TenderCreator")
  tender_documents       TenderDocumentJob[]        @relation("TenderDocGenerator")
  field_sessions_created FieldVerificationSession[] @relation("FieldSessionCreator")

  // Revenue module relations
  penalties UserPenalty[]

  // ── New platform relations ──
  employee        Employee?
  citizen_profile CitizenProfile?
  user_roles      UserRole[]

  @@unique([tenant_id, email])
  @@unique([tenant_id, phone_e164])
  @@index([tenant_id])
  @@map("users")
}

model ElectricPole {
  id          Int                                   @id @default(autoincrement())
  pole_number String?
  keypad_id   String?
  location    Unsupported("geometry(Point, 4326)")?
  latitude    Float?
  longitude   Float?
  org_unit_id Int?
  landmarks   String[]                              @default([])

  /**
   * Permanent UUID token for public QR-code stickers. Never expires.
   */
  public_report_token String? @unique @default(uuid())

  image_url         String?
  image_latitude    Float?
  image_longitude   Float?
  image_captured_at DateTime?
  image_uploaded_at DateTime?
  image_uploaded_by Int?

  org_unit       OrgUnit?    @relation(fields: [org_unit_id], references: [id])
  complaints     Complaint[]
  image_uploader User?       @relation("PoleImageUploader", fields: [image_uploaded_by], references: [id])

  tender_line_items      TenderLineItem[]
  field_uploads_matched  FieldVerificationPhoto[]   @relation("FieldUploadMatched")
  field_uploads_manual   FieldVerificationPhoto[]   @relation("FieldUploadManual")
  tender_checklist_items TenderFieldChecklistItem[]

  @@unique([org_unit_id, keypad_id])
  @@map("electric_poles")
}

model Complaint {
  id              Int      @id @default(autoincrement())
  voice_call_id   Int?
  pole_id         Int?
  pipeline_id     Int?
  tank_id         Int?
  org_unit_id     Int?
  complaint_type  String?
  description     String?
  caller_language String?
  caller_emotion  String?
  urgency_level   String?
  audio_url       String?
  status          String   @default("pending")
  created_at      DateTime @default(now())

  category             String?
  whatsapp_done_ack_at DateTime?

  /**
   * Phone number for guest (non-registered) complaints.
   */
  guest_phone          String?
  /**
   * UUID token for anonymous complaint tracking (public URL).
   */
  guest_tracking_token String? @unique

  assigned_electrician_id Int?
  assigned_plumber_id     Int?
  assigned_at             DateTime?
  resolved_at             DateTime?

  resolution_image_url         String?
  resolution_note              String?
  resolution_image_latitude    Float?
  resolution_image_longitude   Float?
  resolution_image_captured_at DateTime?
  resolution_distance_meters   Float?
  resolution_location_valid    Boolean?
  resolution_submitted_key     String?   @unique

  /**
   * Where the complaint is, independent of any asset.
   * Previously a complaint could only be placed on a map if it happened to
   * reference a pole, pipeline or tank — so potholes, garbage and stray-animal
   * reports, which are most of the volume, were unmappable. The ward-density
   * view and any geographic routing need the location of the *complaint*.
   */
  latitude    Float?
  longitude   Float?
  ward_number String?

  voice_call           VoiceCall?         @relation(fields: [voice_call_id], references: [id])
  pole                 ElectricPole?      @relation(fields: [pole_id], references: [id])
  pipeline             WaterPipeline?     @relation(fields: [pipeline_id], references: [id])
  tank                 WaterTankBorewell? @relation(fields: [tank_id], references: [id])
  org_unit             OrgUnit?           @relation(fields: [org_unit_id], references: [id])
  assigned_electrician User?              @relation("AssignedElectrician", fields: [assigned_electrician_id], references: [id])
  assigned_plumber     User?              @relation("AssignedPlumber", fields: [assigned_plumber_id], references: [id])

  tender_line_items TenderLineItem[]
  penalties         UserPenalty[]

  @@map("complaints")
}

model IvrCallState {
  id                   Int       @id @default(autoincrement())
  call_sid             String    @unique
  phase1_status        String    @default("pending")
  phase2_status        String    @default("pending")
  complaint_created    Boolean   @default(false)
  complaint_id         Int?
  phase1_voice_call_id Int?
  phase2_voice_call_id Int?
  finalized_at         DateTime?
  last_error           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([call_sid])
  @@map("ivr_call_states")
}

model SystemSettings {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

/**
 * Async ZIP export of resolved complaints + proof images (admin).
 */
model ExportJob {
  id                   Int       @id @default(autoincrement())
  created_by_user_id   Int
  org_unit_id          Int?
  electrician_user_id  Int
  range_from           DateTime
  range_to             DateTime
  status               String    @default("pending")
  result_relative_path String?
  error_message        String?
  row_count            Int?
  created_at           DateTime  @default(now())
  completed_at         DateTime?

  created_by  User     @relation("ExportJobCreator", fields: [created_by_user_id], references: [id])
  electrician User     @relation("ExportJobElectrician", fields: [electrician_user_id], references: [id])
  org_unit    OrgUnit? @relation(fields: [org_unit_id], references: [id])

  @@index([electrician_user_id])
  @@index([status])
  @@map("export_jobs")
}

// =====================================================================
//  TENDER WORKFLOW (Phase 1)
// =====================================================================

/**
 * Top-level tender. Drives status machine, milestone rules, and document chain.
 */

/**
 * Top-level tender. Drives status machine, milestone rules, and document chain.
 */
model Tender {
  id                             Int       @id @default(autoincrement())
  org_unit_id                    Int
  status                         String    @default("draft")
  title_ta                       String?
  title_en                       String?
  narrative_ta                   String?
  narrative_en                   String?
  anchor_date                    DateTime?
  milestone_rules                Json?
  quotation_access_mode          String    @default("invited_only")
  auto_resolve_linked_complaints Boolean   @default(false)
  officer_self_inspection        Boolean   @default(false)
  public_token                   String?   @unique
  awarded_quotation_id           Int?      @unique
  work_order_date                DateTime?
  work_completed_at              DateTime?
  inspection_done_at             DateTime?
  inspection_notes               String?
  payment_meta                   Json?
  created_by_user_id             Int
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  org_unit              OrgUnit                    @relation(fields: [org_unit_id], references: [id])
  created_by            User                       @relation("TenderCreator", fields: [created_by_user_id], references: [id])
  awarded_quotation     TenderQuotation?           @relation("AwardedQuotation", fields: [awarded_quotation_id], references: [id])
  invites               TenderInvite[]
  line_items            TenderLineItem[]
  quotations            TenderQuotation[]          @relation("TenderQuotations")
  documents             TenderDocumentJob[]
  verification_sessions FieldVerificationSession[]
  checklist_items       TenderFieldChecklistItem[]

  @@index([org_unit_id, status])
  @@map("tenders")
}

/**
 * Contractor invitation join table for invited_only tender access mode.
 */
model TenderInvite {
  id                  Int       @id @default(autoincrement())
  tender_id           Int
  contractor_id       Int
  invite_token        String?   @unique
  invite_expires_at   DateTime?
  invite_revoked_at   DateTime?
  invite_opened_at    DateTime?
  invite_submitted_at DateTime?
  created_at          DateTime  @default(now())

  tender     Tender     @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractor_id], references: [id], onDelete: Cascade)

  @@unique([tender_id, contractor_id])
  @@index([invite_token, invite_revoked_at])
  @@map("tender_invites")
}

/**
 * Per-line work item; may link to an electric pole and/or a complaint.
 */
model TenderLineItem {
  id             Int      @id @default(autoincrement())
  tender_id      Int
  seq            Int      @default(1)
  description_ta String?
  description_en String?
  quantity       Decimal? @db.Decimal(12, 3)
  unit           String?
  pole_id        Int?
  complaint_id   Int?

  tender          Tender                     @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  pole            ElectricPole?              @relation(fields: [pole_id], references: [id])
  complaint       Complaint?                 @relation(fields: [complaint_id], references: [id])
  checklist_items TenderFieldChecklistItem[]

  @@index([tender_id])
  @@map("tender_line_items")
}

/**
 * Bidder quotation. May come from public POST or officer offline entry.
 */
model TenderQuotation {
  id                   Int      @id @default(autoincrement())
  tender_id            Int
  contractor_id        Int?
  submitter_name       String
  submitter_phone_e164 String
  amount               Decimal  @db.Decimal(12, 2)
  remarks              String?
  attachment_url       String?
  source               String   @default("officer_entry")
  screening_outcome    String   @default("pending")
  superseded_by_id     Int?
  submitted_ip_hash    String?
  submitted_at         DateTime @default(now())

  tender             Tender            @relation("TenderQuotations", fields: [tender_id], references: [id], onDelete: Cascade)
  contractor         Contractor?       @relation(fields: [contractor_id], references: [id])
  superseded_by      TenderQuotation?  @relation("Superseded", fields: [superseded_by_id], references: [id])
  successors         TenderQuotation[] @relation("Superseded")
  awarded_for_tender Tender?           @relation("AwardedQuotation")

  @@index([tender_id])
  @@map("tender_quotations")
}

/**
 * Generated PDF artifact with version chain. status: pending|ready|failed.
 */
model TenderDocumentJob {
  id                   Int       @id @default(autoincrement())
  tender_id            Int
  template_id          String
  contractor_id        Int?
  version              Int       @default(1)
  field_overrides      Json?
  storage_path         String?
  generated_at         DateTime?
  generated_by_user_id Int?
  status               String    @default("pending")
  error_message        String?
  created_at           DateTime  @default(now())

  tender       Tender      @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  contractor   Contractor? @relation(fields: [contractor_id], references: [id])
  generated_by User?       @relation("TenderDocGenerator", fields: [generated_by_user_id], references: [id])

  @@index([tender_id, template_id])
  @@map("tender_document_jobs")
}

/**
 * Token-gated bucket for field-staff EXIF photo uploads.
 */
model FieldVerificationSession {
  id                 Int       @id @default(autoincrement())
  tender_id          Int
  token              String    @unique
  label              String?
  expires_at         DateTime?
  pole_subset_ids    Int[]     @default([])
  created_by_user_id Int
  confirmed_at       DateTime?
  created_at         DateTime  @default(now())

  tender     Tender                   @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  created_by User                     @relation("FieldSessionCreator", fields: [created_by_user_id], references: [id])
  uploads    FieldVerificationPhoto[]

  @@index([tender_id])
  @@map("field_verification_sessions")
}

/**
 * Single image upload with EXIF + nearest-pole match result.
 */
model FieldVerificationPhoto {
  id                   Int       @id @default(autoincrement())
  session_id           Int
  image_url            String
  exif_lat             Float?
  exif_lng             Float?
  captured_at          DateTime?
  ocr_lat              Float?
  ocr_lng              Float?
  ocr_address          String?
  ocr_raw_text         String?
  ocr_captured_at      DateTime?
  ocr_pole_number      String?
  ocr_keypad_id        String?
  ocr_matched_pole_id  Int?
  ocr_match_confidence String    @default("skipped")
  coord_source         String?
  matched_lat          Float?
  matched_lng          Float?
  matched_pole_id      Int?
  manual_pole_id       Int?
  distance_meters      Float?
  match_confidence     String    @default("unmatched")
  notes                String?
  uploaded_at          DateTime  @default(now())

  session         FieldVerificationSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  matched_pole    ElectricPole?              @relation("FieldUploadMatched", fields: [matched_pole_id], references: [id])
  manual_pole     ElectricPole?              @relation("FieldUploadManual", fields: [manual_pole_id], references: [id])
  checklist_items TenderFieldChecklistItem[]

  @@index([session_id])
  @@map("field_verification_photos")
}

/**
 * Officer-facing checklist row per pole/line item; required for tender completion.
 */
model TenderFieldChecklistItem {
  id                 Int      @id @default(autoincrement())
  tender_id          Int
  pole_id            Int?
  line_item_id       Int?
  is_done            Boolean  @default(false)
  verified_upload_id Int?
  notes              String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tender          Tender                  @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  pole            ElectricPole?           @relation(fields: [pole_id], references: [id])
  line_item       TenderLineItem?         @relation(fields: [line_item_id], references: [id])
  verified_upload FieldVerificationPhoto? @relation(fields: [verified_upload_id], references: [id])

  @@index([tender_id])
  @@map("tender_field_checklist_items")
}

model WaterPipeline {
  id           Int      @id @default(autoincrement())
  name         String? // e.g., "Main Annur Conduit"
  org_unit_id  Int
  path_geojson Json // GeoJSON LineString for path rendering and GIS calculations
  diameter_mm  Float?
  material     String? // PVC, HDPE, Cast Iron
  status       String   @default("active") // active, leak_alert, maintenance
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  org_unit   OrgUnit        @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  flow_logs  WaterFlowLog[]
  complaints Complaint[]

  @@index([org_unit_id])
  @@map("water_pipelines")
}

model WaterTankBorewell {
  id                Int      @id @default(autoincrement())
  name              String // e.g., "Coimbatore Reservoir A"
  type              String // overhead_tank, borewell_pump
  latitude          Float
  longitude         Float
  org_unit_id       Int
  capacity_liters   Float?
  current_level_pct Float    @default(100.0) // 0 to 100
  status            String   @default("active") // active, empty, critical, maintenance
  pump_status       String? // on, off, faulty
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  org_unit   OrgUnit        @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  flow_logs  WaterFlowLog[]
  complaints Complaint[]

  @@index([org_unit_id])
  @@map("water_tank_borewells")
}

model WaterValve {
  id           Int      @id @default(autoincrement())
  valve_number String?
  latitude     Float
  longitude    Float
  org_unit_id  Int
  status       String   @default("open") // open, closed, maintenance
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@index([org_unit_id])
  @@map("water_valves")
}

model WaterFlowLog {
  id            BigInt   @id @default(autoincrement())
  pipeline_id   Int?
  tank_id       Int?
  flow_rate_lps Float // Liters per second
  pressure_bar  Float // Water pressure in bars
  logged_at     DateTime @default(now())

  pipeline WaterPipeline?     @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  tank     WaterTankBorewell? @relation(fields: [tank_id], references: [id], onDelete: Cascade)

  @@index([logged_at])
  @@map("water_flow_logs")
}

/**
 * Water asset captured in the field by an agent, pending officer approval.
 * tenant_id/org_unit_id are required: without them a captured asset belonged
 * to no tenant at all, so one tenant's field captures were visible to every
 * other tenant and could not be scoped or approved per org unit.
 */
model AssetFieldCapture {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int
  type         String // household_tap, public_tap, main_pipeline
  material     String // PVC, HDPE, Cast Iron
  diameter_mm  Float
  latitude     Float
  longitude    Float
  photo_url    String?
  status       String   @default("pending_approval") // pending_approval, approved, rejected
  comment      String?
  agent_name   String
  captured_by  Int?
  device_model String?
  altitude     Float?
  precision    Float?
  submitted_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id])

  @@index([tenant_id, org_unit_id, status])
  @@map("asset_field_captures")
}

