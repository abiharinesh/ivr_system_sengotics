// =====================================================================
//  PHASE 0 — CORE PLATFORM FOUNDATION
// =====================================================================

// ─────────────────────────────────────────────────────────────────────
//  0A. MULTI-TENANCY
// ─────────────────────────────────────────────────────────────────────

/**
 * Top-level customer/deployment isolation. Every row in the system is scoped to a tenant.
 */
model Tenant {
  id               String      @id // "tn_govt", "ap_govt", "demo"
  slug             String      @unique // url-safe client identifier, e.g. "madurai-corp"
  name             String // "Tamil Nadu Government"
  branch_type_hint BranchType? // what kind of client this is, used to default provisioning
  domain           String?     @unique // "tn.platform.gov.in"
  logo_url         String?
  config           Json? // Tenant-wide settings
  subscription     String      @default("enterprise") // free, starter, professional, enterprise
  max_branches     Int         @default(100)
  is_active        Boolean     @default(true)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  org_units         OrgUnit[]
  users             User[]
  employees         Employee[]
  roles             Role[]
  permission_groups PermissionGroup[]
  departments       Department[]
  contractors       Contractor[]
  feature_config    TenantFeatureConfig?

  @@map("tenants")
}

/**
 * Subscription-level feature ceiling for a tenant — the per-OrgUnit
 * BranchFeatureConfig may only enable a module if the tenant ceiling allows it.
 */
model TenantFeatureConfig {
  id        Int    @id @default(autoincrement())
  tenant_id String @unique
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  street_light_mgmt  Boolean @default(true)
  water_supply_mgmt  Boolean @default(true)
  complaint_mgmt     Boolean @default(true)
  tender_mgmt        Boolean @default(true)
  certificate_mgmt   Boolean @default(true)
  market_mgmt        Boolean @default(true)
  asset_booking      Boolean @default(true)
  ad_campaign        Boolean @default(true)
  penalty_mgmt       Boolean @default(true)
  ivr_system         Boolean @default(true)
  zone_management    Boolean @default(true)
  solid_waste_mgmt   Boolean @default(true)
  drainage_mgmt      Boolean @default(true)
  road_mgmt          Boolean @default(true)
  parks_mgmt         Boolean @default(true)
  public_health      Boolean @default(true)
  building_permit    Boolean @default(true)
  birth_death_reg    Boolean @default(true)
  vehicle_fleet_mgmt Boolean @default(true)
  cemetery_mgmt      Boolean @default(true)
  encroachment_mgmt  Boolean @default(true)
  property_tax       Boolean @default(true)
  trade_licence      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tenant_feature_configs")
}

// ─────────────────────────────────────────────────────────────────────
//  0B. BRANCH FEATURE CONFIG & LIFECYCLE
// ─────────────────────────────────────────────────────────────────────

/**
 * Feature toggles per branch — Super Admin controls which modules are available.
 */
model BranchFeatureConfig {
  id          Int @id @default(autoincrement())
  org_unit_id Int @unique

  // Existing module toggles
  street_light_mgmt Boolean @default(true)
  water_supply_mgmt Boolean @default(false)
  complaint_mgmt    Boolean @default(true)
  tender_mgmt       Boolean @default(false)
  certificate_mgmt  Boolean @default(false)
  market_mgmt       Boolean @default(false)
  asset_booking     Boolean @default(false)
  ad_campaign       Boolean @default(false)
  penalty_mgmt      Boolean @default(false)
  ivr_system        Boolean @default(false)
  zone_management   Boolean @default(true)

  // Municipality modules.
  //
  // Those with a built implementation default to `true`: a branch that has
  // been provisioned before the module existed must not silently lose the
  // feature when the gate starts being enforced. A super admin turns off what
  // a client has not licensed, rather than turning on everything they have.
  // The rest stay `false` until there is something behind them to enable.
  solid_waste_mgmt   Boolean @default(true)
  building_permit    Boolean @default(true)
  birth_death_reg    Boolean @default(true)
  drainage_mgmt      Boolean @default(false)
  road_mgmt          Boolean @default(false)
  parks_mgmt         Boolean @default(false)
  public_health      Boolean @default(false)
  vehicle_fleet_mgmt Boolean @default(false)
  cemetery_mgmt      Boolean @default(false)
  encroachment_mgmt  Boolean @default(false)

  // Revenue modules. Both were shipped without a toggle, so their screens
  // could not be switched off for a branch that does not levy them — a
  // village panchayat has no trade licensing of its own, and the menu entry
  // led to an empty register. `AppScreen.module` already carries these names.
  property_tax  Boolean @default(true)
  trade_licence Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)

  @@map("branch_feature_configs")
}

/**
 * Tracks every branch status change — creation, merge, upgrade, close.
 */
model BranchLifecycleEvent {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int
  event_type     String // "created", "activated", "deactivated", "merged", "upgraded", "closed", "transferred"
  from_status    String?
  to_status      String
  details        Json? // { merged_from: [3,4], reason: "District reorganization" }
  effective_date DateTime
  performed_by   Int?
  created_at     DateTime @default(now())

  org_unit OrgUnit @relation(fields: [org_unit_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("branch_lifecycle_events")
}

// ─────────────────────────────────────────────────────────────────────
//  0C. EMPLOYEE & RBAC
// ─────────────────────────────────────────────────────────────────────

/**
 * Government employee identity — separate from User login. Tracks service history, cadre, designation.
 */
model Employee {
  id                  Int       @id @default(autoincrement())
  tenant_id           String
  user_id             Int       @unique
  employee_code       String // Auto-generated: "EMP-00042"
  service_book_number String? // Government service book reference
  org_unit_id         Int // Current posting (denormalized cache — authoritative scoping lives on UserRole)
  department_id       Int? // References Department model
  designation         String? // "Municipal Engineer", "AE", "Panchayat Secretary"
  hierarchy_level     Int? // 1=top authority ... higher number = lower rank
  cadre               String? // "TNCS", "TNMS", "TNES"
  date_of_joining     DateTime?
  date_of_retirement  DateTime?
  reporting_to_id     Int? // Direct supervisor's employee ID
  pay_level           String?
  qualification       String?
  photo_url           String?
  status              String    @default("active") // active, on_leave, transferred, retired, suspended
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  user                  User                   @relation(fields: [user_id], references: [id])
  tenant                Tenant                 @relation(fields: [tenant_id], references: [id])
  org_unit              OrgUnit                @relation(fields: [org_unit_id], references: [id])
  department            Department?            @relation(fields: [department_id], references: [id])
  reporting_to          Employee?              @relation("ReportsTo", fields: [reporting_to_id], references: [id])
  reports               Employee[]             @relation("ReportsTo")
  sanitation_attendance SanitationAttendance[]

  @@unique([tenant_id, employee_code])
  @@index([tenant_id, org_unit_id])
  @@map("employees")
}

/**
 * Atomic permission — "complaints.read", "assets.approve".
 */
model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique // "complaints.read", "assets.approve"
  module      String // "complaints", "assets"
  action      String // "read", "write", "approve", "delete", "export"
  description String?

  role_grants RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// A permission granted directly to a role.
///
/// Replaces reading permissions out of `PermissionGroup.permissions`, a JSON
/// array. That shape had three problems for an admin console: a group is
/// shared, so editing one role's access silently changed every other role on
/// the same group; a JSON blob cannot be joined, indexed or audited per row;
/// and there was no way to record *who* granted an individual permission.
///
/// `PermissionGroup` survives as a **preset** — "apply Engineering Access to
/// this role" expands into rows here — but the rows are the truth.
model RolePermission {
  id            Int      @id @default(autoincrement())
  role_id       Int
  permission_id Int
  granted_by    Int?
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("role_permissions")
}

/// The catalogue of navigable screens in the product.
///
/// Seeded from the front-end navigation catalogue so the super admin console
/// has a real, tickable list instead of the list being hardcoded in Dart where
/// nobody can change it. A screen existing here does not mean anyone can see
/// it — [RoleScreenAccess] decides that.
///
/// `permission_code` ties the menu entry to the API permission that backs it,
/// so a role can never be shown a destination whose endpoints would reject it.
model AppScreen {
  id        Int    @id @default(autoincrement())
  /// Stable key shared with the Dart nav catalogue, e.g. "trade_licences".
  key       String @unique
  route     String
  group_key String // "REVENUE", "PUBLIC WORKS", ...

  label_en String
  label_ta String?
  /// Material icon name, resolved to an IconData on the client.
  icon     String

  /// Module this screen belongs to — lines up with `BranchFeatureConfig`
  /// columns so branch provisioning and role access agree.
  module String

  /// API permission a user needs for this screen to be of any use.
  permission_code String?

  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  /// Screens only ever meaningful to the platform operator.
  is_platform_only Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role_access RoleScreenAccess[]

  @@index([group_key, sort_order])
  @@map("app_screens")
}

/// Which roles can see which screens — the table the super admin console
/// writes when a sidebar item is switched on or off for a role.
///
/// Absence of a row means no access: a screen is invisible until granted,
/// rather than visible until forbidden.
model RoleScreenAccess {
  id        Int @id @default(autoincrement())
  role_id   Int
  screen_id Int

  /// Kept as an explicit column rather than relying on row existence alone, so
  /// an access grant can be switched off and back on without losing who
  /// granted it or when.
  can_view Boolean @default(true)

  granted_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role   Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  screen AppScreen @relation(fields: [screen_id], references: [id], onDelete: Cascade)

  @@unique([role_id, screen_id])
  @@index([role_id, can_view])
  @@map("role_screen_access")
}

/**
 * Named group of permissions — "Engineering Full Access".
 */
model PermissionGroup {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  tenant      Tenant @relation(fields: [tenant_id], references: [id])
  name        String // "Engineering Full Access"
  permissions Json // Array of permission codes

  @@unique([tenant_id, name])
  @@map("permission_groups")
}

/**
 * Role definition with hierarchy level and inheritance.
 */
model Role {
  id                    Int      @id @default(autoincrement())
  tenant_id             String // "__system__" for global designation templates, else a real Tenant.id
  org_unit_id           Int? // null = tenant-wide role template
  name                  String // "municipal_engineer" — single merged vocabulary, matches @Roles() decorators
  display_name          String // "Municipal Engineer"
  display_name_ta       String? // "நகராட்சி பொறியாளர்"
  department            String?
  hierarchy_level       Int      @default(5)
  permission_group_id   Int?
  inherits_from_role_id Int? // Role inheritance chain
  is_super_admin        Boolean  @default(false) // replaces hardcoded role==='super_admin' string checks
  can_approve           Boolean  @default(false)
  is_system             Boolean  @default(false) // System roles can't be deleted
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())

  /// Which body types this role is offered for, e.g. ["MUNICIPALITY",
  /// "MUNICIPAL_CORPORATION"]. Empty means every type. A village panchayat has
  /// no Municipal Commissioner, and the console should not offer one.
  applicable_branch_types BranchType[] @default([])

  tenant        Tenant     @relation(fields: [tenant_id], references: [id])
  org_unit      OrgUnit?   @relation(fields: [org_unit_id], references: [id])
  inherits_from Role?      @relation("RoleInheritance", fields: [inherits_from_role_id], references: [id])
  inherited_by  Role[]     @relation("RoleInheritance")
  user_roles    UserRole[]

  permissions   RolePermission[]
  screen_access RoleScreenAccess[]

  @@unique([tenant_id, org_unit_id, name])
  @@index([tenant_id, is_active])
  @@map("roles")
}

/**
 * Links a user to a role at a specific org unit (and optionally department).
 * The single authoritative scoping record — supersedes User.org_unit_id and
 * Employee.access_scope for authorization purposes. Supports temporary permissions.
 */
model UserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  /**
   * The tenant this assignment belongs to.
   *
   * Denormalised on purpose. Tenant used to be reachable only transitively
   * through the role and the branch, which meant every authorization query had
   * to join two tables to establish the boundary — and nothing in the schema
   * stopped a role from one tenant being assigned at another tenant's branch.
   * A trigger keeps this column in agreement with the user and the branch, so
   * the isolation is enforced by the database rather than by every caller
   * remembering to check.
   */
  tenant_id String @default("default")

  org_unit_id   Int // Which org unit this role applies to
  department_id Int? // Optional department scoping within the org unit
  access_scope  String    @default("own_org_unit") // own_org_unit, child_org_units, all_org_units
  is_primary    Boolean   @default(false) // the user's default/login context
  is_temporary  Boolean   @default(false)
  valid_from    DateTime  @default(now())
  valid_until   DateTime? // Temporary permission expiry
  granted_by    Int?
  created_at    DateTime  @default(now())

  user       User        @relation(fields: [user_id], references: [id])
  role       Role        @relation(fields: [role_id], references: [id])
  org_unit   OrgUnit     @relation(fields: [org_unit_id], references: [id])
  department Department? @relation(fields: [department_id], references: [id])

  @@unique([user_id, role_id, org_unit_id, department_id])
  @@index([tenant_id, user_id])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────
//  0D. DEPARTMENTS
// ─────────────────────────────────────────────────────────────────────

/**
 * Organizational department within a branch.
 */
model Department {
  id               Int     @id @default(autoincrement())
  tenant_id        String
  org_unit_id      Int
  code             String // "engineering", "health", "revenue"
  name             String // "Engineering Department"
  name_ta          String? // "பொறியியல் துறை"
  parent_id        Int? // For sub-departments
  head_employee_id Int? // Department head
  display_order    Int     @default(0)
  is_active        Boolean @default(true)

  tenant     Tenant       @relation(fields: [tenant_id], references: [id])
  org_unit   OrgUnit      @relation(fields: [org_unit_id], references: [id])
  parent     Department?  @relation("DeptHierarchy", fields: [parent_id], references: [id])
  children   Department[] @relation("DeptHierarchy")
  employees  Employee[]
  user_roles UserRole[]

  @@unique([tenant_id, org_unit_id, code])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────
//  0E. NUMBER GENERATION
// ─────────────────────────────────────────────────────────────────────

/**
 * Central sequence generator — configurable format per entity type.
 */
model SequenceConfig {
  id            Int       @id @default(autoincrement())
  tenant_id     String
  org_unit_id   Int? // null = tenant-wide
  entity_type   String // "complaint", "work_order", "asset"
  prefix        String // "CMP", "WO", "AST"
  format        String // "{prefix}-{fy}-{seq:6}" → "CMP-2026-000001"
  current_seq   Int       @default(0)
  reset_cycle   String?   @default("financial_year") // financial_year, calendar_year, never
  last_reset_at DateTime?

  @@unique([tenant_id, org_unit_id, entity_type])
  @@map("sequence_configs")
}

// ─────────────────────────────────────────────────────────────────────
//  0F. WORKING CALENDAR, HOLIDAYS & SLA
// ─────────────────────────────────────────────────────────────────────

/**
 * Working calendar — supports multiple per tenant (office, emergency 24×7, sanitation shift).
 */
model WorkingCalendar {
  id                  Int     @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int? // null = tenant-wide default
  name                String // "Standard Government Calendar", "Emergency 24x7"
  working_days        Int[]   @default([1, 2, 3, 4, 5, 6]) // 1=Mon..6=Sat
  working_hours_start String  @default("09:30")
  working_hours_end   String  @default("17:45")
  half_day_hours_end  String? @default("13:00")
  is_default          Boolean @default(false)

  @@index([tenant_id, org_unit_id])
  @@map("working_calendars")
}

/**
 * Holiday definitions — government holidays, state holidays, local holidays.
 */
model Holiday {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int? // null = tenant-wide
  date         DateTime @db.Date
  name         String // "Republic Day"
  name_ta      String? // "குடியரசு தினம்"
  holiday_type String // "national", "state", "local", "restricted", "half_day"
  is_active    Boolean  @default(true)

  @@unique([tenant_id, org_unit_id, date])
  @@map("holidays")
}

/**
 * SLA policy defining resolution targets per entity type and urgency.
 */
model SlaPolicy {
  id               Int      @id @default(autoincrement())
  tenant_id        String
  org_unit_id      Int?
  entity_type      String // "complaint", "building_permit"
  category         String? // "electrical", "plumbing"
  urgency_level    String? // "low", "medium", "high", "critical"
  target_hours     Int // Business hours target
  warning_hours    Int
  escalation_hours Int
  breach_hours     Int
  escalation_role  String?
  is_24x7          Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())

  @@unique([tenant_id, org_unit_id, entity_type, category, urgency_level])
  @@map("sla_policies")
}

/**
 * Live SLA tracker for an individual entity (complaint, permit, etc.).
 */
model SlaTracker {
  id                   Int       @id @default(autoincrement())
  tenant_id            String
  entity_type          String
  entity_id            Int
  sla_policy_id        Int
  started_at           DateTime  @default(now())
  target_at            DateTime
  warning_at           DateTime
  escalation_at        DateTime
  breach_at            DateTime
  paused_at            DateTime?
  resumed_at           DateTime?
  resolved_at          DateTime?
  total_paused_hours   Float     @default(0)
  status               String    @default("on_track") // on_track, warning, escalated, breached, resolved
  delay_reason         String?
  escalated_to_user_id Int?

  @@index([tenant_id, entity_type, entity_id])
  @@index([status, target_at])
  @@map("sla_trackers")
}

// ─────────────────────────────────────────────────────────────────────
//  0G. AUDIT TRAIL
// ─────────────────────────────────────────────────────────────────────

/**
 * Immutable audit log — captures before/after values on every data mutation.
 */
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int?
  user_id        Int?
  module         String // "complaints", "assets"
  entity_type    String // "Complaint", "Asset"
  entity_id      String // "42"
  action         String // "create", "update", "delete", "approve", "login"
  before_value   Json?
  after_value    Json?
  changed_fields String[] @default([])
  device_info    String?
  ip_address     String?
  user_agent     String?
  session_id     String?
  created_at     DateTime @default(now())

  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, user_id, created_at])
  @@index([tenant_id, module, created_at])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────
//  0H. NOTIFICATION ENGINE
// ─────────────────────────────────────────────────────────────────────

/**
 * Notification template with language support.
 */
model NotificationTemplate {
  id            Int     @id @default(autoincrement())
  tenant_id     String
  code          String // "complaint_assigned", "sla_warning"
  channel       String // "whatsapp", "sms", "email", "push", "in_app"
  subject       String?
  body_template String // "Hi {{name}}, complaint #{{id}} assigned."
  language      String  @default("en")
  is_active     Boolean @default(true)

  @@unique([tenant_id, code, channel, language])
  @@map("notification_templates")
}

/**
 * Individual notification with delivery tracking.
 */
model Notification {
  id                BigInt    @id @default(autoincrement())
  tenant_id         String
  recipient_user_id Int?
  recipient_phone   String?
  recipient_email   String?
  template_code     String
  channel           String
  variables         Json?
  rendered_body     String?
  status            String    @default("queued") // queued, sending, sent, failed, read
  retry_count       Int       @default(0)
  max_retries       Int       @default(3)
  error_message     String?
  scheduled_for     DateTime?
  sent_at           DateTime?
  read_at           DateTime?
  created_at        DateTime  @default(now())

  @@index([tenant_id, recipient_user_id, status])
  @@index([status, created_at])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────
//  0I. DOCUMENT MANAGEMENT SYSTEM
// ─────────────────────────────────────────────────────────────────────

/**
 * Folder hierarchy for organizing documents.
 */
model DocumentFolder {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  name        String
  parent_id   Int?
  created_at  DateTime @default(now())

  parent   DocumentFolder?  @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children DocumentFolder[] @relation("FolderHierarchy")

  @@map("document_folders")
}

/**
 * Document with versioning, tagging, digital signature, and expiry.
 */
model Document {
  id                Int       @id @default(autoincrement())
  tenant_id         String
  org_unit_id       Int
  folder_id         Int?
  title             String
  file_name         String
  storage_key       String // Provider-agnostic (S3, local, etc.)
  file_url          String?
  file_size_bytes   BigInt?
  mime_type         String?
  version           Int       @default(1)
  parent_doc_id     Int? // Previous version link
  tags              String[]  @default([])
  module            String? // "complaints", "tenders"
  entity_type       String?
  entity_id         Int?
  digital_signature Json? // { signer, signed_at, cert_hash }
  expires_at        DateTime?
  uploaded_by       Int
  created_at        DateTime  @default(now())

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by Int?

  @@index([tenant_id, org_unit_id, module])
  @@index([tenant_id, entity_type, entity_id])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────
//  0J. POLYMORPHIC COMMENTS
// ─────────────────────────────────────────────────────────────────────

/**
 * Reusable comment system — works across complaints, assets, tenders, inspections.
 */
model Comment {
  id             Int      @id @default(autoincrement())
  tenant_id      String
  entity_type    String // "complaint", "asset", "work_order", "tender"
  entity_id      Int
  user_id        Int
  body           String
  attachment_url String?
  is_internal    Boolean  @default(true) // Internal note vs public-facing
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  @@index([tenant_id, entity_type, entity_id])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────
//  0K. WORKFLOW ENGINE (with versioning + conditional rules)
// ─────────────────────────────────────────────────────────────────────

/**
 * Workflow definition for a branch — versioned so in-progress workflows aren't broken.
 */
model WorkflowTemplate {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  name        String // "complaint_resolution", "work_order_approval"
  description String?
  department  String?
  version     Int      @default(1)
  status      String   @default("draft") // draft, published, archived
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  org_unit  OrgUnit            @relation(fields: [org_unit_id], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  rules     WorkflowRule[]
  instances WorkflowInstance[]

  @@unique([org_unit_id, name, version])
  @@map("workflow_templates")
}

/**
 * Individual step in a workflow approval chain.
 */
model WorkflowStep {
  id                  Int     @id @default(autoincrement())
  template_id         Int
  step_order          Int
  role_name           String // "commissioner", "me", "ae", "je"
  action_type         String // "review", "approve", "execute", "verify", "notify"
  is_required         Boolean @default(true)
  auto_escalate_hours Int?
  sla_hours           Int?

  template WorkflowTemplate     @relation(fields: [template_id], references: [id], onDelete: Cascade)
  actions  WorkflowStepAction[]
  rules    WorkflowRule[]

  @@unique([template_id, step_order])
  @@map("workflow_steps")
}

/**
 * Conditional routing rules — amount-based, urgency-based, department-based.
 */
model WorkflowRule {
  id              Int     @id @default(autoincrement())
  template_id     Int
  step_id         Int
  condition_field String // "estimated_cost", "urgency_level"
  condition_op    String // "gt", "lt", "eq", "in", "between"
  condition_value Json
  then_action     String // "skip_step", "add_step", "route_to_role"
  then_value      String?
  priority        Int     @default(1)

  template WorkflowTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [step_id], references: [id])

  @@map("workflow_rules")
}

/**
 * A running instance of a workflow for a specific entity (complaint, work order, etc.).
 */
model WorkflowInstance {
  id                 Int       @id @default(autoincrement())
  tenant_id          String
  template_id        Int
  entity_type        String // "complaint", "work_order", "tender"
  entity_id          Int
  current_step_order Int       @default(1)
  status             String    @default("in_progress") // in_progress, completed, rejected, escalated
  started_at         DateTime  @default(now())
  completed_at       DateTime?

  template WorkflowTemplate     @relation(fields: [template_id], references: [id])
  actions  WorkflowStepAction[]

  @@index([tenant_id, entity_type, entity_id])
  @@map("workflow_instances")
}

/**
 * Log of each approval action taken in a workflow.
 */
model WorkflowStepAction {
  id            Int      @id @default(autoincrement())
  instance_id   Int
  step_id       Int
  actor_user_id Int?
  action        String // "approved", "rejected", "escalated", "returned", "executed"
  comments      String?
  acted_at      DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [step_id], references: [id])

  @@map("workflow_step_actions")
}

// ─────────────────────────────────────────────────────────────────────
//  0L. INTEGRATION FRAMEWORK
// ─────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────
//  0M. CONFIG, LOCALIZATION & SCHEDULING
// ─────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────
//  0N. GENERIC ASSET MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

/**
 * Generic asset — electric poles, water tanks, borewells, transformers, parks, etc.
 */
model Asset {
  id              Int     @id @default(autoincrement())
  tenant_id       String
  org_unit_id     Int
  asset_type_code String // "electric_pole", "water_tank", "park", "vehicle", ...
  asset_uuid      String  @unique @default(uuid()) // Immutable internal ID
  asset_code      String? // Human-readable, can change: "SL-MDU-Z3-042"
  name            String?

  // Location
  latitude  Float?
  longitude Float?
  zone_id   Int?
  address   String?
  landmarks String[] @default([])

  // Lifecycle
  installed_at      DateTime?
  manufacturer      String?
  model_number      String?
  serial_number     String?
  condition_rating  Int?      @default(5)
  is_operational    Boolean   @default(true)
  decommissioned_at DateTime?

  // Type-specific data (flexible schema)
  custom_data Json? // { "wattage": 100, "pole_type": "steel", "height_m": 8.5 }

  notes      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  images AssetImage[]
  zone   Zone?        @relation(fields: [zone_id], references: [id])

  @@index([tenant_id, org_unit_id, asset_type_code])
  @@index([asset_uuid])
  @@index([zone_id])
  @@map("assets")
}

/**
 * Asset photo with enhanced metadata for field verification.
 */
model AssetImage {
  id          Int     @id @default(autoincrement())
  asset_id    Int
  storage_key String
  image_url   String?
  image_type  String // "installation", "current", "damage", "repair"
  caption     String?

  // Enhanced metadata
  file_size_bytes Int?
  resolution      String? // "1920x1080"
  captured_device String?
  exif_data       Json?
  gps_lat         Float?
  gps_lng         Float?
  gps_accuracy_m  Float?

  captured_at DateTime?
  uploaded_by Int?
  uploaded_at DateTime  @default(now())

  asset Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([asset_id])
  @@map("asset_images")
}

// ─────────────────────────────────────────────────────────────────────
//  0O. CONTRACTOR & WORK ORDER MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

/**
 * A single external party that does work for the local body — used both as a
 * tender bidder and as the recipient of a work order. Previously this was two
 * tables (`vendors` for the tender side, `contractors` for the work-order
 * side), which meant a bidder who won a tender had to be re-created as a
 * separate contractor row with a different id.
 * `org_unit_id` is nullable: null = empanelled tenant-wide, set = registered
 * at one specific org unit (the old vendor behaviour).
 */
model Contractor {
  id                  Int      @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int?
  name                String
  phone               String
  email               String?
  place               String?
  notes               String?
  gst_number          String?
  pan_number          String?
  registration_number String?
  category            String[] @default([]) // ["electrical", "civil", "plumbing"]
  rating              Float?
  blacklisted         Boolean  @default(false)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())

  tenant      Tenant              @relation(fields: [tenant_id], references: [id])
  org_unit    OrgUnit?            @relation(fields: [org_unit_id], references: [id])
  work_orders WorkOrder[]
  invites     TenderInvite[]
  quotations  TenderQuotation[]
  documents   TenderDocumentJob[]

  // Soft delete
  is_deleted Boolean   @default(false)
  deleted_at DateTime?

  @@unique([tenant_id, phone])
  @@index([tenant_id])
  @@index([org_unit_id])
  @@map("contractors")
}

/**
 * Formal work order issued to a contractor or municipal maintenance team.
 */
model WorkOrder {
  id                  Int       @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int
  work_order_number   String? // Auto-generated via SequenceConfig
  contractor_id       Int?
  tender_id           Int?
  title               String
  description         String?
  estimated_cost      Decimal?  @db.Decimal(14, 2)
  actual_cost         Decimal?  @db.Decimal(14, 2)
  status              String    @default("draft") // draft, issued, in_progress, completed, verified, paid
  issued_at           DateTime?
  start_date          DateTime?
  expected_completion DateTime?
  actual_completion   DateTime?
  completion_cert_url String?
  measurement_book    Json? // [{ desc, qty, unit, rate, amount }]
  financial_year_code String? // "2025-26"
  created_by          Int
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  contractor Contractor? @relation(fields: [contractor_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("work_orders")
}

// ─────────────────────────────────────────────────────────────────────
//  0P. CITIZEN PORTAL
// ─────────────────────────────────────────────────────────────────────

/**
 * Citizen profile linked to a user account.
 */
model CitizenProfile {
  id          Int      @id @default(autoincrement())
  tenant_id   String
  user_id     Int      @unique
  full_name   String
  phone       String
  email       String?
  address     String?
  ward        String?
  org_unit_id Int
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([tenant_id, org_unit_id])
  @@map("citizen_profiles")
}

/**
 * Public announcements from a branch to citizens.
 */
model Announcement {
  id           Int       @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int
  title        String
  title_ta     String?
  body         String
  body_ta      String?
  category     String? // "general", "water", "road", "event"
  is_pinned    Boolean   @default(false)
  published_at DateTime  @default(now())
  expires_at   DateTime?
  created_by   Int

  @@index([tenant_id, org_unit_id])
  @@map("announcements")
}

/**
 * Citizen feedback/rating for services.
 */
model CitizenFeedback {
  id              Int      @id @default(autoincrement())
  tenant_id       String
  org_unit_id     Int
  citizen_user_id Int?
  entity_type     String? // "complaint", "service"
  entity_id       Int?
  rating          Int // 1-5
  comment         String?
  created_at      DateTime @default(now())

  @@index([tenant_id, org_unit_id])
  @@map("citizen_feedback")
}

// ─────────────────────────────────────────────────────────────────────
//  0Q. FIELD INSPECTION MODULE
// ─────────────────────────────────────────────────────────────────────

/**
 * Reusable inspection template with checklist items.
 */
model InspectionTemplate {
  id              Int     @id @default(autoincrement())
  tenant_id       String
  name            String
  asset_type_code String? // null = any asset type
  checklist_items Json // [{ item: "Wiring intact", type: "yes_no" }]
  is_active       Boolean @default(true)

  @@map("inspection_templates")
}

/**
 * Individual field inspection record with GPS, photos, signature.
 */
model FieldInspection {
  id                Int      @id @default(autoincrement())
  tenant_id         String
  org_unit_id       Int
  template_id       Int?
  inspector_user_id Int
  asset_id          Int?
  location_lat      Float?
  location_lng      Float?
  gps_locked        Boolean  @default(false)
  gps_accuracy_m    Float?
  checklist_results Json?
  overall_score     Int?
  photos            Json?
  signature_url     String?
  remarks           String?
  status            String   @default("completed")
  inspected_at      DateTime @default(now())

  @@index([tenant_id, org_unit_id])
  @@map("field_inspections")
}

// ─────────────────────────────────────────────────────────────────────
//  0R. DASHBOARD & REPORTING ENGINE
// ─────────────────────────────────────────────────────────────────────

/**
 * Configurable dashboard widget definition.
 */
model DashboardWidget {
  id           Int     @id @default(autoincrement())
  tenant_id    String
  code         String
  title        String
  widget_type  String // "counter", "pie_chart", "bar_chart", "table", "map", "kpi"
  data_source  String
  query_config Json
  default_size String  @default("medium")
  is_active    Boolean @default(true)

  @@unique([tenant_id, code])
  @@map("dashboard_widgets")
}

/**
 * Role-specific dashboard layout.
 */
model RoleDashboard {
  id         Int    @id @default(autoincrement())
  tenant_id  String
  role_name  String
  widget_ids Int[]
  layout     Json?

  @@unique([tenant_id, role_name])
  @@map("role_dashboards")
}

/**
 * Saved report with optional scheduling.
 */
model SavedReport {
  id             Int       @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int?
  name           String
  report_type    String
  format         String    @default("pdf") // pdf, excel, csv
  filters        Json?
  schedule_cron  String?
  email_to       String[]  @default([])
  last_generated DateTime?
  created_by     Int
  created_at     DateTime  @default(now())

  @@map("saved_reports")
}

// ─────────────────────────────────────────────────────────────────────
//  0S. DYNAMIC FORM BUILDER
// ─────────────────────────────────────────────────────────────────────

/**
 * Dynamic form template — complaint form, building permit, birth registration.
 */
model FormTemplate {
  id         Int      @id @default(autoincrement())
  tenant_id  String
  code       String
  name       String
  name_ta    String?
  module     String
  version    Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  fields FormField[]

  @@unique([tenant_id, code, version])
  @@map("form_templates")
}

/**
 * Individual field in a dynamic form.
 */
model FormField {
  id            Int     @id @default(autoincrement())
  template_id   Int
  field_key     String
  field_type    String // "text", "number", "date", "select", "file", "gps", "photo", "signature"
  label         String
  label_ta      String?
  placeholder   String?
  options       Json? // For select fields
  validation    Json? // { required: true, min: 0, max: 100 }
  display_order Int
  section       String?
  visible_when  Json? // Conditional visibility
  is_required   Boolean @default(false)

  template FormTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("form_fields")
}

/**
 * Submitted form data linked to an entity.
 */
model FormSubmission {
  id           Int      @id @default(autoincrement())
  tenant_id    String
  org_unit_id  Int
  template_id  Int
  submitted_by Int?
  data         Json
  status       String   @default("submitted")
  entity_type  String?
  entity_id    Int?
  submitted_at DateTime @default(now())

  @@index([tenant_id, org_unit_id, template_id])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────────────────────────────
//  1A. BUILDING PERMITS & PLAN APPROVAL
// ─────────────────────────────────────────────────────────────────────

/**
 * Where a permit application sits in its statutory lifecycle.
 * `SUBMITTED → SCRUTINY` is the clerical completeness check; `NOC_PENDING`
 * means the file is out with the clearing departments (fire, traffic, EB…);
 * `INSPECTION` is the physical site visit. Approval only becomes possible
 * once every mandatory NOC is granted and the fee is paid — see
 * `BuildingPermitService.approve`.
 */
enum BuildingPermitStatus {
  DRAFT
  SUBMITTED
  SCRUTINY
  NOC_PENDING
  INSPECTION
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  EXPIRED
}

/**
 * Clearance state of a single department's no-objection certificate.
 */
enum NocStatus {
  PENDING
  GRANTED
  REJECTED
  NOT_APPLICABLE
}

/**
 * A citizen's application to construct, extend or alter a building.
 * The record is deliberately thin on process state: approvals live in
 * `WorkflowInstance`, deadlines in `SlaTracker`, blueprints and NOC letters in
 * `Document` (entity_type `building_permit`), and every mutation in
 * `AuditLog`. Only fields the town-planning office actually queries or prints
 * are stored as columns here.
 */
model BuildingPermit {
  id            Int    @id @default(autoincrement())
  tenant_id     String
  org_unit_id   Int
  permit_number String @unique // PERMIT-2026-0001, from NumberGenService

  // ── Applicant ──
  applicant_name    String
  applicant_phone   String?
  applicant_email   String?
  applicant_address String?
  applicant_aadhaar String? // Masked at rest by the service layer
  is_owner          Boolean @default(true)
  power_of_attorney String? // Name of the authorised representative, if not the owner

  // ── Site ──
  survey_number  String
  subdivision_no String?
  ward_number    String?
  street_name    String?
  door_number    String?
  plot_area_sqm  Decimal @db.Decimal(12, 2)
  latitude       Float?
  longitude      Float?

  // ── Proposal ──
  construction_type String // "residential", "commercial", "industrial", "institutional", "mixed"
  work_nature       String   @default("new") // "new", "extension", "alteration", "reconstruction"
  built_up_area_sqm Decimal  @db.Decimal(12, 2)
  floors_proposed   Int      @default(1)
  height_m          Decimal? @db.Decimal(6, 2)
  setback_front_m   Decimal? @db.Decimal(6, 2)
  setback_rear_m    Decimal? @db.Decimal(6, 2)
  setback_left_m    Decimal? @db.Decimal(6, 2)
  setback_right_m   Decimal? @db.Decimal(6, 2)
  estimated_cost    Decimal? @db.Decimal(14, 2)

  // ── Licensed surveyor / architect who prepared the plan ──
  architect_name    String?
  architect_licence String?

  // ── Fees ──
  scrutiny_fee    Decimal   @default(0) @db.Decimal(12, 2)
  permit_fee      Decimal   @default(0) @db.Decimal(12, 2)
  development_fee Decimal   @default(0) @db.Decimal(12, 2)
  total_fee       Decimal   @default(0) @db.Decimal(12, 2)
  payment_status  String    @default("unpaid") // unpaid, partial, paid
  paid_amount     Decimal   @default(0) @db.Decimal(12, 2)
  payment_ref     String?
  paid_at         DateTime?

  // ── Lifecycle ──
  status           BuildingPermitStatus @default(DRAFT)
  rejection_reason String?
  approved_by      Int?
  approved_at      DateTime?
  /// Statutory validity — TN building permits lapse if work has not begun.
  valid_until      DateTime?
  submitted_at     DateTime?
  created_by       Int?
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  org_unit    OrgUnit                    @relation(fields: [org_unit_id], references: [id])
  nocs        BuildingPermitNoc[]
  inspections BuildingPermitInspection[]

  @@index([tenant_id, org_unit_id, status])
  @@index([tenant_id, org_unit_id, survey_number])
  @@index([applicant_phone])
  @@map("building_permits")
}

/**
 * One department's clearance on a permit. Rows are created from the
 * department list configured for the org unit, so which clearances a permit
 * needs is data, not code.
 */
model BuildingPermitNoc {
  id           Int       @id @default(autoincrement())
  permit_id    Int
  department   String // "fire", "traffic", "electricity", "highways", "pollution", "airport"
  is_mandatory Boolean   @default(true)
  status       NocStatus @default(PENDING)
  reference_no String?
  remarks      String?
  cleared_by   Int?
  cleared_at   DateTime?
  requested_at DateTime  @default(now())

  permit BuildingPermit @relation(fields: [permit_id], references: [id], onDelete: Cascade)

  @@unique([permit_id, department])
  @@index([status])
  @@map("building_permit_nocs")
}

/**
 * A scheduled or completed site visit against a permit. Mirrors the shape of
 * `FieldInspection` (GPS lock, photos, remarks) but is permit-scoped, because
 * `FieldInspection` hangs off an `asset_id` and a permit has no asset until
 * the building exists.
 */
model BuildingPermitInspection {
  id                Int       @id @default(autoincrement())
  permit_id         Int
  inspection_type   String // "site_verification", "plinth_level", "completion"
  scheduled_for     DateTime
  inspector_user_id Int?
  status            String    @default("scheduled") // scheduled, completed, cancelled
  location_lat      Float?
  location_lng      Float?
  gps_accuracy_m    Float?
  findings          String?
  is_compliant      Boolean?
  photos            Json?
  inspected_at      DateTime?
  created_at        DateTime  @default(now())

  permit BuildingPermit @relation(fields: [permit_id], references: [id], onDelete: Cascade)

  @@index([permit_id, status])
  @@index([inspector_user_id, scheduled_for])
  @@map("building_permit_inspections")
}

// ─────────────────────────────────────────────────────────────────────
//  1B. BIRTH & DEATH REGISTRATION (Registration of Births and Deaths Act, 1969)
// ─────────────────────────────────────────────────────────────────────

enum VitalEventType {
  BIRTH
  DEATH
}

/**
 * Lifecycle of a register entry.
 * `REPORTED` is what arrives from a hospital feed or an informant at the
 * counter. `REGISTERED` is the legal act — a serial number is allotted in the
 * register and only then can a certificate issue. `CORRECTED` marks an entry
 * amended under s.15 after registration; the original values stay in the audit
 * log, never overwritten silently.
 */
enum VitalEventStatus {
  REPORTED
  VERIFIED
  REGISTERED
  REJECTED
  CORRECTED
}

/**
 * Where the report came from — drives which particulars are mandatory.
 */
enum ReportingSource {
  HOSPITAL
  INSTITUTION
  DOMICILIARY
  SELF_REPORTED
}

/**
 * One entry in the statutory birth or death register.
 * Distinct from `CertificateRequest`, which is a citizen *asking for a copy* of
 * a certificate. This is the register itself: the event, its particulars, and
 * the registrar's act of recording it. A `CertificateRequest` for a birth or
 * death should resolve against a registered `VitalEvent` rather than carry
 * loose `application_data`.
 * Particulars live in `BirthDetail` / `DeathDetail` rather than as nullable
 * columns here — the two forms share almost nothing beyond the event itself,
 * and a single table would be two-thirds nulls whichever way it was filled.
 */
model VitalEvent {
  id                  Int              @id @default(autoincrement())
  tenant_id           String
  org_unit_id         Int
  event_type          VitalEventType
  /// Allotted at registration, not at report — null until then.
  registration_number String?          @unique
  status              VitalEventStatus @default(REPORTED)

  // ── The event ──
  event_date    DateTime @db.Date
  event_time    String? // "14:35" — recorded when known, often isn't
  place_type    String // "hospital", "home", "institution", "vehicle", "public_place"
  place_name    String?
  place_address String?
  latitude      Float?
  longitude     Float?

  // ── Reporting ──
  reporting_source ReportingSource @default(SELF_REPORTED)
  hospital_name    String?
  hospital_reg_no  String?
  reported_at      DateTime        @default(now())

  // ── Informant (s.8/s.9 — the person legally bound to report) ──
  informant_name     String
  informant_relation String // "father", "mother", "husband", "wife", "son", "hospital_official", "other"
  informant_phone    String?
  informant_address  String?
  informant_aadhaar  String? // Masked to last 4 by the service layer

  // ── Late registration (s.13) ──
  /// Reports later than 21 days after the event need written permission;
  /// beyond a year, a magistrate's order. Computed at intake, never trusted
  /// from the client.
  is_late_registration Boolean @default(false)
  delay_days           Int     @default(0)
  delay_approval_ref   String?

  // ── Registrar's act ──
  registered_at    DateTime?
  registered_by    Int?
  rejection_reason String?
  correction_note  String?

  created_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_unit     OrgUnit            @relation(fields: [org_unit_id], references: [id])
  birth        BirthDetail?
  death        DeathDetail?
  certificates VitalCertificate[]

  @@index([tenant_id, org_unit_id, event_type, status])
  @@index([tenant_id, event_date])
  @@index([informant_phone])
  @@map("vital_events")
}

/**
 * Birth particulars — Form 1 of the Act.
 */
model BirthDetail {
  id             Int      @id @default(autoincrement())
  vital_event_id Int      @unique
  /// Frequently blank at registration; parents have a year to supply it.
  child_name     String?
  sex            String // "male", "female", "transgender"
  weight_kg      Decimal? @db.Decimal(4, 2)
  delivery_type  String? // "normal", "caesarean", "forceps", "other"

  father_name       String?
  father_aadhaar    String?
  father_education  String?
  father_occupation String?

  mother_name            String
  mother_aadhaar         String?
  mother_education       String?
  mother_occupation      String?
  mother_age_at_marriage Int?
  mother_age_at_birth    Int?
  birth_order            Int?

  address_at_birth  String?
  permanent_address String?

  is_multiple_birth    Boolean @default(false)
  multiple_birth_order Int?

  event VitalEvent @relation(fields: [vital_event_id], references: [id], onDelete: Cascade)

  @@index([child_name])
  @@index([mother_name])
  @@map("birth_details")
}

/**
 * Death particulars — Form 2 of the Act.
 */
model DeathDetail {
  id             Int    @id @default(autoincrement())
  vital_event_id Int    @unique
  deceased_name  String
  sex            String // "male", "female", "transgender"

  /// Age is recorded in whichever unit is meaningful — an infant death is
  /// counted in days, not a rounded-down zero years.
  age_years  Int?
  age_months Int?
  age_days   Int?

  date_of_birth DateTime? @db.Date
  father_name   String?
  mother_name   String?
  spouse_name   String?
  occupation    String?
  address       String?

  cause_of_death      String?
  cause_category      String? // "natural", "accident", "suicide", "homicide", "pending_investigation"
  medically_certified Boolean @default(false)
  certifying_doctor   String?
  doctor_reg_no       String?

  disposal_method String? // "burial", "cremation", "donation"
  disposal_place  String?
  disposal_date   DateTime? @db.Date

  event VitalEvent @relation(fields: [vital_event_id], references: [id], onDelete: Cascade)

  @@index([deceased_name])
  @@map("death_details")
}

/**
 * An issued certificate. Every copy is its own row — the register has to be
 * able to say who was given a certificate, when, and for what purpose, and a
 * reissue must not overwrite the record of the first one.
 */
model VitalCertificate {
  id                 Int    @id @default(autoincrement())
  vital_event_id     Int
  certificate_number String @unique
  /// Random token embedded in the printed QR code. Public verification looks
  /// up on this, never on the sequential certificate number, so a valid
  /// certificate can't be found by counting.
  verification_token String @unique
  copy_number        Int    @default(1)

  issued_to          String
  issued_to_relation String?
  purpose            String?

  fee_amount  Decimal @default(0) @db.Decimal(10, 2)
  payment_ref String?

  /// Hash over the certificate's material particulars at issue time. A
  /// verifier can be shown that what's printed matches what was sealed.
  seal_hash   String?
  /// The generated PDF in the shared DMS, when one has been rendered.
  document_id Int?

  issued_by        Int?
  issued_at        DateTime  @default(now())
  is_cancelled     Boolean   @default(false)
  cancelled_reason String?
  cancelled_at     DateTime?

  event VitalEvent @relation(fields: [vital_event_id], references: [id], onDelete: Cascade)

  @@index([vital_event_id, copy_number])
  @@map("vital_certificates")
}

// ─────────────────────────────────────────────────────────────────────
//  1C. SOLID WASTE MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

/**
 * Fill level of a public bin, as observed.
 * Five bands rather than a raw percentage because that is what a sanitary
 * worker can actually judge from a passing vehicle, and what the map legend
 * shows: EMPTY/LOW render green, MEDIUM yellow, HIGH/OVERFLOWING red.
 */
enum BinFillLevel {
  EMPTY
  LOW
  MEDIUM
  HIGH
  OVERFLOWING
}

enum BinStatus {
  ACTIVE
  DAMAGED
  REMOVED
  RELOCATED
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

/**
 * A public bin or dumpster the body is responsible for emptying.
 * Deliberately its own table rather than an `Asset` with
 * `asset_type_code = "waste_bin"`: a bin's defining behaviour is a fill level
 * that changes several times a day and drives an SLA, which is nothing like
 * the install-and-inspect lifecycle `Asset` models. The zone link is shared
 * with `Asset` so both appear on the same GIS layer.
 */
model WasteBin {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  bin_code    String @unique // BIN-000042, from NumberGenService

  bin_type        String // "community", "litter", "segregated_wet", "segregated_dry", "compactor"
  capacity_litres Int
  /// Denormalised from the latest reading so the map can paint without a
  /// per-pin subquery. `WasteBinReading` remains the source of truth.
  fill_level      BinFillLevel @default(EMPTY)
  fill_pct        Int          @default(0)
  status          BinStatus    @default(ACTIVE)

  // Location
  latitude    Float
  longitude   Float
  zone_id     Int?
  ward_number String?
  landmark    String?

  installed_at    DateTime?
  last_emptied_at DateTime?
  last_read_at    DateTime?

  created_by Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_unit OrgUnit               @relation(fields: [org_unit_id], references: [id])
  zone     Zone?                 @relation(fields: [zone_id], references: [id])
  readings WasteBinReading[]
  stops    CollectionRouteStop[]

  @@index([tenant_id, org_unit_id, status])
  @@index([tenant_id, org_unit_id, fill_level])
  @@index([zone_id])
  @@map("waste_bins")
}

/**
 * One observation of a bin's fill level. Append-only — the history is what
 * tells a supervisor whether a bin is under-sized or its route is too
 * infrequent, so readings are never updated in place.
 */
model WasteBinReading {
  id          Int          @id @default(autoincrement())
  bin_id      Int
  fill_level  BinFillLevel
  fill_pct    Int
  /// True when this reading recorded the bin being emptied, not just observed.
  emptied     Boolean      @default(false)
  photo_url   String?
  remarks     String?
  latitude    Float?
  longitude   Float?
  recorded_by Int?
  recorded_at DateTime     @default(now())

  bin WasteBin @relation(fields: [bin_id], references: [id], onDelete: Cascade)

  @@index([bin_id, recorded_at])
  @@map("waste_bin_readings")
}

/**
 * A named door-to-door collection round — the plan, not a particular day's run.
 */
model CollectionRoute {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  name        String
  route_code  String @unique

  zone_id      Int?
  ward_number  String?
  /// 1=Mon … 7=Sun. A route that runs alternate days simply lists those days.
  service_days Int[]   @default([1, 2, 3, 4, 5, 6])
  shift        String  @default("morning") // morning, afternoon, night

  /// Default crew and vehicle; a trip may override either.
  default_vehicle_asset_id Int?
  household_count          Int?
  distance_km              Decimal? @db.Decimal(6, 2)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  org_unit OrgUnit               @relation(fields: [org_unit_id], references: [id])
  zone     Zone?                 @relation(fields: [zone_id], references: [id])
  stops    CollectionRouteStop[]
  trips    CollectionTrip[]

  @@index([tenant_id, org_unit_id, is_active])
  @@map("collection_routes")
}

/**
 * An ordered stop on a route. A stop is either a public bin or a plain
 * door-to-door point that has no bin of its own.
 */
model CollectionRouteStop {
  id              Int    @id @default(autoincrement())
  route_id        Int
  seq             Int
  bin_id          Int?
  label           String // "Anna Nagar 3rd Street — north end"
  latitude        Float?
  longitude       Float?
  household_count Int?

  route  CollectionRoute      @relation(fields: [route_id], references: [id], onDelete: Cascade)
  bin    WasteBin?            @relation(fields: [bin_id], references: [id])
  visits CollectionTripStop[]

  @@unique([route_id, seq])
  @@index([bin_id])
  @@map("collection_route_stops")
}

/**
 * One day's run of a route — the vehicle log entry.
 */
model CollectionTrip {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int
  route_id    Int
  trip_number String @unique // TRIP-2026-000042

  trip_date DateTime   @db.Date
  /// A route that runs twice a day produces two trips on the same date, so
  /// the shift is part of what makes a trip unique.
  shift     String     @default("morning")
  status    TripStatus @default(PLANNED)

  vehicle_asset_id Int?
  vehicle_number   String? // Denormalised for the log, vehicles get replaced
  driver_user_id   Int?
  crew_size        Int?

  started_at DateTime?
  ended_at   DateTime?

  /// Filled from the weighbridge at the transfer station.
  waste_collected_kg Decimal? @db.Decimal(10, 2)
  segregated_wet_kg  Decimal? @db.Decimal(10, 2)
  segregated_dry_kg  Decimal? @db.Decimal(10, 2)
  odometer_start_km  Int?
  odometer_end_km    Int?

  /// Cached progress so the board renders without counting stops per row.
  stops_total     Int @default(0)
  stops_completed Int @default(0)

  abandon_reason String?
  remarks        String?
  created_by     Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  org_unit OrgUnit              @relation(fields: [org_unit_id], references: [id])
  route    CollectionRoute      @relation(fields: [route_id], references: [id])
  stops    CollectionTripStop[]

  @@unique([route_id, trip_date, shift])
  @@index([tenant_id, org_unit_id, trip_date])
  @@index([status, trip_date])
  @@map("collection_trips")
}

/**
 * Completion of a single stop on a trip, with the GPS fix that proves the
 * vehicle was actually there.
 */
model CollectionTripStop {
  id            Int @id @default(autoincrement())
  trip_id       Int
  route_stop_id Int
  seq           Int

  completed      Boolean   @default(false)
  skipped        Boolean   @default(false)
  skip_reason    String?
  latitude       Float?
  longitude      Float?
  gps_accuracy_m Float?
  photo_url      String?
  completed_at   DateTime?

  trip       CollectionTrip      @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  route_stop CollectionRouteStop @relation(fields: [route_stop_id], references: [id])

  @@unique([trip_id, route_stop_id])
  @@index([trip_id, seq])
  @@map("collection_trip_stops")
}

/**
 * Daily attendance for sanitation staff.
 * Separate from any general HR attendance because sanitation runs shifts that
 * start before the office calendar does, and the count that matters to a
 * sanitary inspector is "how many workers do I have on this route this
 * morning", not a monthly total.
 */
model SanitationAttendance {
  id          Int    @id @default(autoincrement())
  tenant_id   String
  org_unit_id Int

  employee_id  Int?
  /// Many sanitation workers are engaged on contract and have no Employee row.
  worker_name  String
  worker_phone String?
  is_contract  Boolean @default(false)

  attendance_date DateTime         @db.Date
  shift           String           @default("morning")
  status          AttendanceStatus @default(PRESENT)
  route_id        Int?

  check_in_at  DateTime?
  check_out_at DateTime?
  check_in_lat Float?
  check_in_lng Float?

  remarks     String?
  recorded_by Int?
  created_at  DateTime @default(now())

  org_unit OrgUnit   @relation(fields: [org_unit_id], references: [id])
  employee Employee? @relation(fields: [employee_id], references: [id])

  @@unique([org_unit_id, worker_name, attendance_date, shift])
  @@index([tenant_id, org_unit_id, attendance_date])
  @@index([employee_id, attendance_date])
  @@map("sanitation_attendance")
}

// ─────────────────────────────────────────────────────────────────────
//  1D. TRADE LICENCE & RENEWAL
// ─────────────────────────────────────────────────────────────────────

/**
 * Where a licence sits in its lifecycle.
 * `APPROVED` is the live state and the one a renewal returns it to.
 * `EXPIRED` is reached by the passage of time, not by an officer's act — the
 * nightly sweep sets it. `SUSPENDED` is an enforcement action a licence can
 * come back from; `CANCELLED` is terminal.
 */
enum TradeLicenceStatus {
  DRAFT
  SUBMITTED
  INSPECTION
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
  CANCELLED
}

/**
 * Legal form of the applicant — determines who may sign.
 */
enum OwnershipType {
  PROPRIETOR
  PARTNERSHIP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  SOCIETY
  TRUST
  COOPERATIVE
}

/**
 * A licence to carry on a trade within the body's limits.
 * The licence year runs with the financial year (1 April – 31 March) whatever
 * the grant date, so `valid_until` is derived from the year end rather than a
 * rolling twelve months. `licence_year` is stored denormalised ("2026-27")
 * because every renewal report groups on it.
 */
model TradeLicence {
  id             Int                @id @default(autoincrement())
  tenant_id      String
  org_unit_id    Int
  licence_number String             @unique // TL/2026-27/000042
  status         TradeLicenceStatus @default(DRAFT)

  // ── The trade ──
  trade_name         String
  trade_category     String // "eatery", "provision_store", "workshop", ...
  trade_sub_category String?
  description        String?
  /// Motive power in horsepower. A workshop above a threshold is a different
  /// fee band and, for some categories, a different approving authority.
  motive_power_hp    Decimal? @db.Decimal(8, 2)
  worker_count       Int?
  operating_hours    String? // "06:00-22:00"

  // ── Applicant ──
  owner_name     String
  ownership_type OwnershipType @default(PROPRIETOR)
  signatory_name String? // When the applicant is not the proprietor
  owner_phone    String?
  owner_email    String?
  owner_address  String?
  owner_aadhaar  String? // Masked to last 4 by the service layer

  // ── Premises ──
  door_number        String?
  street_name        String?
  ward_number        String?
  survey_number      String?
  area_sqft          Decimal @db.Decimal(10, 2)
  is_rented          Boolean @default(false)
  landlord_name      String?
  rent_agreement_ref String?
  latitude           Float?
  longitude          Float?

  // ── Statutory references held by the trade, not issued here ──
  fssai_number             String?
  fssai_expiry             DateTime? @db.Date
  gst_number               String?
  fire_noc_ref             String?
  fire_noc_expiry          DateTime? @db.Date
  pollution_consent_ref    String?
  pollution_consent_expiry DateTime? @db.Date

  // ── Current licence year ──
  /// Financial year this licence is currently valid for, e.g. "2026-27".
  licence_year String?
  valid_from   DateTime? @db.Date
  valid_until  DateTime? @db.Date

  // ── Fees for the current year ──
  base_fee       Decimal   @default(0) @db.Decimal(12, 2)
  area_fee       Decimal   @default(0) @db.Decimal(12, 2)
  power_fee      Decimal   @default(0) @db.Decimal(12, 2)
  penalty_fee    Decimal   @default(0) @db.Decimal(12, 2)
  total_fee      Decimal   @default(0) @db.Decimal(12, 2)
  paid_amount    Decimal   @default(0) @db.Decimal(12, 2)
  payment_status String    @default("unpaid") // unpaid, partial, paid
  payment_ref    String?
  paid_at        DateTime?

  // ── Decisions ──
  approved_by       Int?
  approved_at       DateTime?
  rejection_reason  String?
  suspension_reason String?
  suspended_at      DateTime?
  cancelled_reason  String?
  cancelled_at      DateTime?

  submitted_at DateTime?
  created_by   Int?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  org_unit     OrgUnit                   @relation(fields: [org_unit_id], references: [id])
  renewals     TradeLicenceRenewal[]
  inspections  TradeLicenceInspection[]
  certificates TradeLicenceCertificate[]

  @@index([tenant_id, org_unit_id, status])
  @@index([tenant_id, org_unit_id, valid_until])
  @@index([tenant_id, trade_category])
  @@index([owner_phone])
  @@map("trade_licences")
}

/**
 * One licence year in the chain.
 * A row is written for the first grant as well as every renewal, so the
 * register can show a continuous history rather than only the current year —
 * "was this shop licensed in 2024-25?" has to be answerable.
 */
model TradeLicenceRenewal {
  id           Int    @id @default(autoincrement())
  licence_id   Int
  licence_year String // "2026-27"

  valid_from  DateTime @db.Date
  valid_until DateTime @db.Date

  /// Days past the 31 March deadline this renewal was applied for. Zero on an
  /// on-time renewal and on the original grant.
  days_late    Int    @default(0)
  penalty_band String @default("ontime") // ontime, late_30, late_90, lapsed

  base_fee    Decimal @default(0) @db.Decimal(12, 2)
  area_fee    Decimal @default(0) @db.Decimal(12, 2)
  power_fee   Decimal @default(0) @db.Decimal(12, 2)
  penalty_fee Decimal @default(0) @db.Decimal(12, 2)
  total_fee   Decimal @default(0) @db.Decimal(12, 2)
  paid_amount Decimal @default(0) @db.Decimal(12, 2)
  payment_ref String?

  /// True for the row created when the licence was first granted.
  is_initial_grant Boolean @default(false)

  renewed_by Int?
  renewed_at DateTime @default(now())

  licence TradeLicence @relation(fields: [licence_id], references: [id], onDelete: Cascade)

  @@unique([licence_id, licence_year])
  @@index([licence_year])
  @@map("trade_licence_renewals")
}

/**
 * A premises inspection against a licence — before first grant, and annually
 * for categories that require it.
 */
model TradeLicenceInspection {
  id                Int      @id @default(autoincrement())
  licence_id        Int
  inspection_type   String // "pre_licence", "annual", "complaint_driven", "re_inspection"
  scheduled_for     DateTime
  inspector_user_id Int?
  status            String   @default("scheduled") // scheduled, completed, cancelled

  is_compliant Boolean?
  findings     String?
  violations   String[]  @default([])
  latitude     Float?
  longitude    Float?
  photos       Json?
  inspected_at DateTime?
  created_at   DateTime  @default(now())

  licence TradeLicence @relation(fields: [licence_id], references: [id], onDelete: Cascade)

  @@index([licence_id, status])
  @@index([inspector_user_id, scheduled_for])
  @@map("trade_licence_inspections")
}

/**
 * The printed licence for a given year. Reissues get their own row so the
 * register records every document that went out, and each carries its own
 * public verification token.
 */
model TradeLicenceCertificate {
  id                 Int    @id @default(autoincrement())
  licence_id         Int
  licence_year       String
  certificate_number String @unique
  /// Random token behind the QR printed on the licence displayed in the shop.
  verification_token String @unique
  copy_number        Int    @default(1)

  seal_hash   String?
  document_id Int?

  issued_by        Int?
  issued_at        DateTime  @default(now())
  is_cancelled     Boolean   @default(false)
  cancelled_reason String?
  cancelled_at     DateTime?

  licence TradeLicence @relation(fields: [licence_id], references: [id], onDelete: Cascade)

  @@index([licence_id, licence_year])
  @@map("trade_licence_certificates")
}
