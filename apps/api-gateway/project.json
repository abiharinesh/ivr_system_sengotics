{
  "name": "api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node ./node_modules/@nestjs/cli/bin/nest.js build api-gateway", "cwd": "." }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "node ./node_modules/@nestjs/cli/bin/nest.js start api-gateway --watch", "cwd": "." }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "node dist/apps/api-gateway/main.js", "cwd": "." }
    }
  }
}
